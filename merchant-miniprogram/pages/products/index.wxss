.item-more-btn:active {
  transform: scale(.9);
  background: #f0efec;
}

.item-more-btn .more-action-icon {
  opacity: .78;
}

.item-price-box {
  padding: 4rpx 10rpx 4rpx 0;
}

.item-currency {
  color: #514d47;
  font-size: 21rpx;
  font-weight: 700;
}

.item-price-val {
  color: #1d1b19;
  font-size: 33rpx;
  font-weight: 750;
  letter-spacing: -.4rpx;
  font-variant-numeric: tabular-nums;
}

.item-stock {
  padding: 6rpx 11rpx;
  border: 1rpx solid #dce9df;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f1f7f2 0%, #e9f2eb 100%);
  color: #285c38;
  font-size: 19rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.item-stock.out {
  border-color: #f0d9d6;
  background: linear-gradient(180deg, #fff7f6 0%, #f9ecea 100%);
  color: #9e3e35;
}

.item-specs {
  color: #716c65;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.45;
}

.action-menu {
  border-color: #e4e1dc;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 12rpx 30rpx rgba(29, 27, 25, .17), inset 0 1rpx 0 #fff;
}

.menu-item {
  color: #34312c;
  font-size: 23rpx;
  font-weight: 600;
  transition: background-color var(--motion-fast), padding-left var(--motion-fast);
}

.menu-item:active {
  padding-left: 32rpx;
  background: #f4f3f0;
}

.menu-item.danger {
  color: #a23b32;
}

.product-list-screen .ui-button--primary,
.product-list-screen .ui-button--secondary {
  font-weight: 650;
  letter-spacing: .15rpx;
  transition: transform var(--motion-fast), box-shadow var(--motion-fast), filter var(--motion-fast);
}

.product-list-screen .ui-button--primary:active,
.product-list-screen .ui-button--secondary:active {
  transform: translateY(2rpx) scale(.985);
  filter: brightness(.96);
}
