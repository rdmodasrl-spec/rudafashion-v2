}

.product-summary-card .mobile-summary-value {
  color: #1d1b19;
  font-size: 30rpx;
}

.product-summary-card .mobile-summary-label {
  color: #858585;
}

.product-summary-card .mobile-summary-grid {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top-color: #e9e9e9;
}

.product-summary-card .mobile-summary-stat {
  border-left-color: #e9e9e9;
}

.product-summary-card .mobile-summary-stat:first-child {
  border-left: 0;
}

.product-summary-add {
  display: flex;
  width: 100%;
  height: 68rpx !important;
  min-height: 68rpx !important;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  border-radius: 18rpx !important;
  font-size: 22rpx !important;
}

.product-summary-skeleton {
  min-height: 150rpx;
  margin-bottom: 14rpx;
