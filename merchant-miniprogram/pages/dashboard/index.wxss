  right: 0;
  left: 0;
  max-height: 440rpx;
  overflow: hidden;
  padding: 0;
  background: #fff;
}

.home-search-list {
  max-height: 440rpx;
}

.home-search-state {
  padding: 28rpx 24rpx;
  color: #777;
  font-size: 24rpx;
  text-align: center;
}

.home-search-error,
.home-state-error {
  color: #9d3030;
}

.home-search-result {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.home-search-image {
  width: 76rpx;
  height: 88rpx;
  flex: 0 0 76rpx;
  margin-right: 18rpx;
  border-radius: 10rpx;
  background: #f1f1f1;
}

.home-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e7e7e7;
  background: linear-gradient(135deg, #f4f4f4, #e8e8e8);
}

.home-placeholder-icon {
  display: block;
  width: 38rpx;
  height: 38rpx;
  opacity: .5;
}

.home-search-info {
  min-width: 0;
  flex: 1;
}

.home-search-name,
.home-search-code {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-search-name {
  color: #222;
  font-size: 26rpx;
  font-weight: 600;
}

.home-search-code {
  margin-top: 6rpx;
  color: #888;
  font-size: 22rpx;
}

.home-result-arrow,
.home-product-arrow,
.home-task-arrow {
  display: block;
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
}

.home-shortcuts {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 56rpx;
}

.home-shortcut {
  display: flex;
  min-width: 0;
  min-height: 144rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.home-shortcut-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #ededed;
  border-radius: 26rpx;
  background: #fff;
  color: #303030;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .055), inset 0 1rpx 0 #fff;
  transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease;
}

.home-shortcut-icon-add {
  background: #1d1b19;
  color: #fff;
  border-color: #1d1b19;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, .16), inset 0 1rpx 0 rgba(255, 255, 255, .16);
}

.home-shortcut-label {
  margin-top: 12rpx;
  color: #4d4d4d;
  font-size: 22rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.home-shortcut-glyph {
  display: block;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
}

.home-section {
  margin-top: 32rpx;
}

.home-recent-section {
  margin-top: 84rpx;
}

.home-pending-section {
  margin-top: 48rpx;
}

.home-overview-section {
  margin-top: 48rpx;
}

.home-overview-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.home-overview-stat {
  min-width: 0;
  padding: 18rpx 12rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 20rpx;
  background: #fff;
}

.home-overview-label,
.home-overview-value {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-overview-label {
  color: #858585;
  font-size: 20rpx;
}

.home-overview-value {
  margin-top: 8rpx;
  color: #1d1b19;
  font-size: 24rpx;
  font-weight: 600;
}

.home-section-heading {
  display: flex;
  min-height: 46rpx;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.home-section-link,
.home-empty-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #777;
  font-size: 22rpx;
}

.home-product-card {
  display: flex;
  min-height: 208rpx;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.home-product-image {
  width: 152rpx;
  height: 184rpx;
  flex: 0 0 152rpx;
  margin-right: 22rpx;
  border-radius: 14rpx;
  background: #f1f1f1;
}

.home-product-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-self: stretch;
  justify-content: center;
}

.home-product-name {
  overflow: hidden;
  color: #222;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-product-style,
.home-product-summary {
  overflow: hidden;
  color: #888;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-product-style {
  margin-top: 7rpx;
}

.home-product-price-row {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.home-product-price {
  overflow: hidden;
  color: #1d1b19;
  font-size: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-product-stock {
  flex: 0 0 auto;
  margin-left: 8rpx;
  color: #444;
  font-size: 22rpx;
}

.home-product-stock.is-unavailable {
  color: #9d3030;
}

.home-product-summary {
  margin-top: 5rpx;
}

.home-product-arrow {
  margin-left: 12rpx;
}

.home-empty-state {
  display: flex;
  min-height: 136rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 24rpx;
  text-align: center;
}

.home-recent-empty {
  box-sizing: border-box;
  min-height: 250rpx;
  padding: 24rpx;
}

.home-empty-hint {
  color: #858585;
  font-size: 30rpx;
  line-height: 1.5;
}

.home-empty-link {
  margin-top: 28rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
}

.home-link-arrow {
  display: block;
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
}

.home-recent-loading {
  display: flex;
  min-height: 208rpx;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 24rpx;
  background: #fff;
}

.home-recent-skeleton {
  width: 152rpx;
  height: 184rpx;
  flex: 0 0 152rpx;
  margin-right: 22rpx;
  border-radius: 14rpx;
  background: #ededed;
}

.home-recent-skeleton-copy {
  flex: 1;
}

.home-skeleton-line {
  width: 100%;
  height: 20rpx;
  margin: 12rpx 0;
  border-radius: 8rpx;
  background: #ededed;
}

.home-skeleton-line.short {
  width: 55%;
}

.home-task-list {
  overflow: hidden;
  padding: 0 20rpx;
}

.home-task-list-empty {
  display: flex;
  min-height: 124rpx;
  align-items: center;
  justify-content: center;
}

.home-task-row {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  border-bottom: 1rpx solid #efefef;
}

.home-task-row:last-child {
  border-bottom: 0;
}

.home-task-icon {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  margin-right: 18rpx;
}

.home-task-copy {
  min-width: 0;
  flex: 1;
}

.home-task-title {
  display: block;
  color: #2c2c2c;
  font-size: 28rpx;
  font-weight: 600;
}

.home-task-description {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #888;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-task-count {
  margin: 0 18rpx;
  color: #292929;
  font-size: 26rpx;
  font-weight: 600;
}

.home-task-message,
.home-task-empty {
  padding: 24rpx 0;
  color: #858585;
  font-size: 30rpx;
  text-align: center;
}

.home-error-notice {
  margin-top: 24rpx;
  color: #9d3030;
  font-size: 23rpx;
  text-align: center;
}

.ui-button-pressed,
.ui-row-pressed {
  opacity: .88;
}

@media (max-width: 360px) {
  .home-screen {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .home-product-card {
    padding: 16rpx;
  }

  .home-product-image {
    width: 132rpx;
    height: 164rpx;
    flex-basis: 132rpx;
    margin-right: 16rpx;
  }

  .home-product-price {
    font-size: 32rpx;
  }

  .home-product-stock {
    font-size: 19rpx;
  }
}
