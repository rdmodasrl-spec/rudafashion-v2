generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountIdentity {
  id               String             @id @default(uuid())
  email            String
  emailVerifiedAt  DateTime?
  phone            String?            @unique
  phoneVerifiedAt  DateTime?
  passwordHash     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  scope            String             @default("public")
  authAccount      AuthAccount[]
  merchantEmployee MerchantEmployee[]

  @@unique([scope, email])
  @@index([emailVerifiedAt])
  @@index([phoneVerifiedAt])
}

model Consumer {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  passwordSalt       String?
  firstName          String
  lastName           String
  gender             String?
  birthday           DateTime?
  avatarUrl          String?
  phone              String?
  country            String?
  currency           String              @default("EUR")
  preferredLang      String?
  emailVerifiedAt    DateTime?
  status             String              @default("active")
  points             Int                 @default(0)
  level              String              @default("silver")
  totalSpent         Decimal             @default(0) @db.Decimal(14, 2)
  ordersCount        Int                 @default(0)
  newsletterOptIn    Boolean             @default(false)
  addresses          Json                @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  lastLoginAt        DateTime?
  lastLoginIp        String?
  authAccount        AuthAccount?
  growthCrmFollowUps GrowthCrmFollowUp[]
  wishlistItems      ConsumerWishlistItem[]
  orders             Order[]

  @@index([phone])
  @@index([status])
}

/// 消费者收藏（零售愿望清单）。唯一约束保证收藏操作幂等，商品下架后仍保留记录，由读取侧过滤可见性。
model ConsumerWishlistItem {
  id         String   @id @default(uuid())
  consumerId String
  productId  String
  createdAt  DateTime @default(now())
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([consumerId, productId])
  @@index([consumerId, createdAt])
  @@index([productId])
}

model AdminTwoFactor {
  id                String    @id @default(uuid())
  adminAccountId    String    @unique
  secretEncrypted   String
  enabled           Boolean   @default(false)
  recoveryCodesHash String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enabled])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeCreativeDraft {
  id                             String                         @id @default(uuid())
  merchantId                     String
  installationId                 String
  productId                      String?
  prompt                         String                         @db.VarChar(1000)
  image                          Bytes
  imageMime                      String                         @default("image/webp") @db.VarChar(32)
  imageWidth                     Int
  imageHeight                    Int
  model                          String                         @db.VarChar(120)
  status                         String                         @default("pending_review") @db.VarChar(24)
  reviewedBy                     String?
  reviewedAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  merchantAiEmployeeInstallation MerchantAiEmployeeInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  merchant                       Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product                        Product?                       @relation(fields: [productId], references: [id])

  @@index([installationId, status, createdAt])
  @@index([merchantId, status, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeDefinition {
  id                    String                           @id @default(uuid())
  slug                  String                           @unique @db.VarChar(80)
  name                  String                           @db.VarChar(120)
  department            String                           @db.VarChar(40)
  description           String
  version               String                           @default("0.1.0") @db.VarChar(32)
  status                String                           @default("planned") @db.VarChar(24)
  capabilities          String                           @default("[]")
  requiredPermissions   String                           @default("[]")
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  merchantInstallations MerchantAiEmployeeInstallation[]

  @@index([status, department])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeProductContentDraft {
  id                             String                         @id @default(uuid())
  merchantId                     String
  installationId                 String
  productId                      String
  language                       String                         @db.VarChar(8)
  sourceTitle                    String?
  sourceDescription              String?
  title                          String                         @db.VarChar(120)
  description                    String
  status                         String                         @default("pending") @db.VarChar(24)
  reviewedBy                     String?
  reviewedAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  merchantAiEmployeeInstallation MerchantAiEmployeeInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  merchant                       Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product                        Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([installationId, productId, language, status], map: "AiEmployeeProductContentDraft_installationId_productId_language")
  @@index([merchantId, status, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeProductImportDraft {
  id                             String                         @id @default(uuid())
  merchantId                     String
  installationId                 String
  sourceFilename                 String                         @db.VarChar(255)
  sourceType                     String                         @db.VarChar(16)
  extractedData                  String
  status                         String                         @default("pending") @db.VarChar(24)
  productId                      String?
  reviewedBy                     String?
  reviewedAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  merchantAiEmployeeInstallation MerchantAiEmployeeInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  merchant                       Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product                        Product?                       @relation(fields: [productId], references: [id])

  @@index([installationId, status, createdAt], map: "AiEmployeeProductImportDraft_installationId_status_createdAt_id")
  @@index([merchantId, status, createdAt])
}

model Appointment {
  id            String   @id @default(uuid())
  appointmentNo String   @unique
  showroomId    String
  showroomName  String
  date          String
  time          String
  visitorCount  Int      @default(1)
  companyName   String
  contactPerson String
  phone         String
  email         String
  interests     String
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  showroom      Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)

  @@index([appointmentNo])
  @@index([date])
  @@index([showroomId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  role        String
  action      String
  entity      String
  entityId    String
  oldValue    String?
  newValue    String?
  timestamp   DateTime @default(now())
  ip          String?
  requestId   String?
  merchantId  String?
  targetType  String?
  beforeState String?
  afterState  String?
  result      String?  @default("success")
  errorCode   String?
  metadata    String?

  @@index([entity, entityId])
  @@index([timestamp])
  @@index([userId])
  @@index([merchantId, timestamp])
  @@index([requestId])
}

model AuthAccount {
  id                    String                @id @default(uuid())
  role                  String
  email                 String?
  username              String?
  customerId            String?               @unique
  consumerId            String?               @unique
  merchantId            String?               @unique
  merchantCode          String?               @unique
  passwordHash          String
  require2fa            Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lastLoginAt           DateTime?
  lastLoginIp           String?
  googleSub             String?               @unique
  wechatOpenId          String?               @unique
  permissions           String                @default("[]")
  companyId             String?
  partnerId             String?               @unique
  preferences           String                @default("{}")
  phone                 String?
  identityId            String?
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  consumer              Consumer?             @relation(fields: [consumerId], references: [id])
  company               Company?              @relation(fields: [companyId], references: [id])
  accountIdentity       AccountIdentity?      @relation(fields: [identityId], references: [id])
  partner               Partner?              @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  miniProgramIdentities MiniProgramIdentity[]

  @@unique([role, email])
  @@unique([role, phone])
  @@unique([role, username])
  @@index([companyId])
  @@index([customerId])
  @@index([emailVerifiedAt])
  @@index([email])
  @@index([googleSub])
  @@index([identityId])
  @@index([merchantCode])
  @@index([merchantId])
  @@index([role])
  @@index([username])
}

model MiniProgramIdentity {
  id            String      @id @default(uuid())
  appId         String      @db.VarChar(64)
  openId        String      @db.VarChar(128)
  authAccountId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  authAccount   AuthAccount @relation(fields: [authAccountId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
  @@unique([appId, authAccountId])
  @@index([authAccountId])
}

model Partner {
  id                    String                   @id @default(uuid())
  partnerCode           String                   @unique
  role                  String
  status                String                   @default("pending")
  name                  String
  email                 String
  phone                 String?
  telegramId            String?
  country               String                   @default("")
  city                  String                   @default("")
  region                String                   @default("")
  language              String                   @default("en")
  parentId              String?
  commissionRate        Decimal                  @default(0) @db.Decimal(5, 2)
  cityCommissionRate    Decimal                  @default(0) @db.Decimal(5, 2)
  partnerCommissionRate Decimal                  @default(0) @db.Decimal(5, 2)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  account               AuthAccount?
  parent                Partner?                 @relation("PartnerHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Partner[]                @relation("PartnerHierarchy")
  campaigns             PartnerCampaign[]
  clicks                PartnerReferralClick[]
  referrals             PartnerReferral[]        @relation("ReferralPartner")
  cityReferrals         PartnerReferral[]        @relation("ReferralCityPartner")
  networkReferrals      PartnerReferral[]        @relation("ReferralNetworkPartner")
  commissionEntries     PartnerCommissionEntry[]
  auditEvents           PartnerAuditEvent[]
  referredOrders        Order[]                  @relation("OrderReferralPartner")
  cityOrders            Order[]                  @relation("OrderReferralCityPartner")
  networkOrders         Order[]                  @relation("OrderReferralNetworkPartner")

  @@index([parentId, role, status])
  @@index([role, status])
  @@index([country, city])
  @@index([email])
}

model PartnerCampaign {
  id           String                 @id @default(uuid())
  partnerId    String
  campaignCode String                 @unique
  name         String
  channel      String
  status       String                 @default("active")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  partner      Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks       PartnerReferralClick[]
  referrals    PartnerReferral[]

  @@index([partnerId, status, createdAt])
}

model PartnerReferralClick {
  id             String           @id @default(uuid())
  partnerId      String
  campaignId     String?
  visitorKeyHash String
  source         String           @default("link")
  landingPath    String?
  clickedAt      DateTime         @default(now())
  partner        Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  campaign       PartnerCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([partnerId, visitorKeyHash, clickedAt])
  @@index([partnerId, clickedAt])
  @@index([campaignId, clickedAt])
  @@index([clickedAt])
}

model PartnerReferral {
  id                String                   @id @default(uuid())
  customerId        String                   @unique
  partnerId         String
  cityPartnerId     String?
  networkPartnerId  String?
  campaignId        String?
  source            String                   @default("link")
  landingPath       String?
  firstClickAt      DateTime?
  registeredAt      DateTime                 @default(now())
  firstPaidAt       DateTime?
  createdAt         DateTime                 @default(now())
  customer          Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  partner           Partner                  @relation("ReferralPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  cityPartner       Partner?                 @relation("ReferralCityPartner", fields: [cityPartnerId], references: [id], onDelete: SetNull)
  networkPartner    Partner?                 @relation("ReferralNetworkPartner", fields: [networkPartnerId], references: [id], onDelete: SetNull)
  campaign          PartnerCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  orders            Order[]
  commissionEntries PartnerCommissionEntry[]
  changes           PartnerReferralChange[]

  @@index([partnerId, registeredAt])
  @@index([cityPartnerId, registeredAt])
  @@index([networkPartnerId, registeredAt])
  @@index([campaignId, registeredAt])
  @@index([registeredAt])
  @@index([firstPaidAt])
}

model PartnerReferralChange {
  id                String          @id @default(uuid())
  referralId        String
  previousPartnerId String?
  newPartnerId      String
  operatorId        String
  reason            String
  createdAt         DateTime        @default(now())
  referral          PartnerReferral @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@index([referralId, createdAt])
  @@index([operatorId, createdAt])
}

model PartnerCommissionEntry {
  id             String                   @id @default(uuid())
  referralId     String
  orderId        String
  partnerId      String
  role           String
  entryType      String                   @default("commission")
  basisAmount    Decimal                  @db.Decimal(14, 2)
  rate           Decimal                  @db.Decimal(5, 2)
  amount         Decimal                  @db.Decimal(14, 2)
  status         String                   @default("pending")
  idempotencyKey String                   @unique
  sourceRefundId String?
  reversalOfId   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  referral       PartnerReferral          @relation(fields: [referralId], references: [id], onDelete: Restrict)
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner        Partner                  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  sourceRefund   RefundTransaction?       @relation("CommissionRefund", fields: [sourceRefundId], references: [id], onDelete: Restrict)
  reversalOf     PartnerCommissionEntry?  @relation("CommissionReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      PartnerCommissionEntry[] @relation("CommissionReversals")

  @@index([partnerId, status, createdAt])
  @@index([orderId])
  @@index([sourceRefundId])
  @@index([reversalOfId])
}

model PartnerAuditEvent {
  id         String   @id @default(uuid())
  partnerId  String?
  operatorId String
  action     String
  entityType String
  entityId   String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([operatorId, createdAt])
}

model Company {
  id                 String                @id @default(uuid())
  legalName          String
  displayName        String
  vatNumber          String?               @unique
  registrationNumber String?
  country            String
  city               String
  address            String                @default("")
  postalCode         String                @default("")
  website            String                @default("")
  status             String                @default("DRAFT")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  phone              String?               @unique
  accounts           AuthAccount[]
  businessRoles      CompanyBusinessRole[]
  companyDocument    CompanyDocument[]
  verification       CompanyVerification?
  customers          Customer[]
  merchants          Merchant[]
  merchantEmployee   MerchantEmployee[]

  @@index([country, city])
  @@index([status])
}

model CompanyBusinessRole {
  id        String   @id @default(uuid())
  companyId String
  role      String
  status    String   @default("pending")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role])
  @@index([companyId, status])
  @@index([role, status])
}

model CompanyDocument {
  id           String   @id @default(uuid())
  companyId    String
  documentType String
  fileName     String
  mimeType     String
  fileSize     Int
  storageUrl   String
  status       String   @default("pending")
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, documentType])
  @@index([companyId, status])
}

model CompanyVerification {
  id              String    @id @default(uuid())
  companyId       String    @unique
  status          String    @default("pending")
  riskLevel       String    @default("unknown")
  provider        String?
  providerRef     String?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  riskScore       Int       @default(0)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, riskLevel])
}

model ContactVerificationCode {
  id          String    @id @default(uuid())
  destination String
  channel     String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([destination, channel, purpose, expiresAt], map: "ContactVerificationCode_destination_channel_purpose_expiresAt_i")
}

model CreditLedgerEntry {
  id           String   @id @default(uuid())
  customerId   String
  orderId      String?
  entryType    String
  amount       Decimal  @db.Decimal(14, 2)
  balanceAfter Decimal  @db.Decimal(14, 2)
  note         String?
  operatorId   String?
  createdAt    DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([entryType])
  @@index([orderId])
}

model Customer {
  id                         String                      @id @default(uuid())
  companyName                String
  vatNumber                  String
  address                    String
  city                       String
  country                    String
  contactPerson              String
  phone                      String
  email                      String
  avatarUrl                  String?
  businessType               String                      @default("Boutique")
  websiteOrSocial            String                      @default("")
  status                     String                      @default("pending")
  tier                       String                      @default("tier_standard")
  creditLimit                Decimal                     @default(0) @db.Decimal(12, 2)
  usedCredit                 Decimal                     @default(0) @db.Decimal(12, 2)
  discountRate               Decimal                     @default(1.0) @db.Decimal(5, 4)
  registrationDate           String
  approvedAt                 String?
  ordersCount                Int                         @default(0)
  totalSpent                 Decimal                     @default(0) @db.Decimal(14, 2)
  onboardingStatus           String                      @default("document_check")
  documents                  String?
  paymentSlips               String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  companyId                  String?
  customerLevel              String                      @default("new_customer")
  company                    Company?                    @relation(fields: [companyId], references: [id])
  partnerReferral            PartnerReferral?
  growthCrmFollowUps         GrowthCrmFollowUp[]
  merchantAiOrderDraft       MerchantAiOrderDraft[]
  merchantLinks              MerchantCustomerLink[]
  orders                     Order[]
  orderInvoice               OrderInvoice[]
  returnRequest              ReturnRequest[]
  salesQuote                 SalesQuote[]
  productReservationRequests ProductReservationRequest[]
  vaultReqs                  VaultAccessRequest[]

  @@index([companyId])
  @@index([country])
  @@index([createdAt])
  @@index([email])
  @@index([status])
  @@index([tier])
  @@index([vatNumber])
}

model EmailVerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  purpose    String    @default("quick_buyer_registration")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, expiresAt])
}

model EmployeeAuditLog {
  id         String            @id @default(uuid())
  merchantId String
  employeeId String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime          @default(now())
  employee   MerchantEmployee? @relation(fields: [employeeId], references: [id])
  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([entityType, entityId])
  @@index([merchantId, createdAt])
}

model FashionCommunityComment {
  id                   String                    @id @default(uuid())
  contentId            String
  postId               String?
  viewerId             String
  displayName          String
  text                 String
  createdAt            DateTime
  parentId             String?
  // visible | removed (removed by moderation, retained for audit)
  status               String                    @default("visible")
  fashionCommunityPost FashionCommunityPost?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent               FashionCommunityComment?  @relation("FashionCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies              FashionCommunityComment[] @relation("FashionCommentReplies")

  @@index([contentId, createdAt])
  @@index([postId])
  @@index([parentId])
}

model FashionCommunityFollow {
  id        String   @id @default(uuid())
  creatorId String
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([creatorId, viewerId])
  @@index([creatorId])
  @@index([viewerId])
}

model FashionCommunityPost {
  id                String                        @id @default(uuid())
  image             String
  merchantId        String
  merchantName      String
  createdAt         DateTime
  featured          Boolean                       @default(false)
  title             String?
  caption           String?
  category          String?
  mediaType         String                        @default("image")
  videoUrl          String?
  videoStorageKey   String?
  imageStorageKey   String?
  posterStorageKey  String?
  rightsStatus      String                        @default("authorized")
  publicationStatus String                        @default("pending")
  engagementScore   Int                           @default(0)
  updatedAt         DateTime                      @updatedAt
  city              String?
  // Canonical season label (春季 | 夏季 | 秋季 | 冬季). Null for legacy posts that
  // predate season selection; null rows stay visible in every season filter.
  season            String?
  mediaItems        Json?
  hashtags          String[]                      @default([])
  creatorAccountId  String?
  // Legacy single-product column (migration 20261023140000). New posts use
  // productLinks -> FashionCommunityPostProduct; kept for schema/DB parity.
  productId         String?
  comments          FashionCommunityComment[]
  creatorAccount    FashionAccount?               @relation(fields: [creatorAccountId], references: [id])
  reactions         FashionCommunityReaction[]
  views             FashionCommunityView[]
  productLinks      FashionCommunityPostProduct[]

  @@index([merchantId, createdAt])
  @@index([creatorAccountId, createdAt])
  @@index([publicationStatus, createdAt, id])
  @@index([publicationStatus, engagementScore, createdAt, id], map: "FashionCommunityPost_publicationStatus_engagementScore_createdA")
  @@index([city, category, publicationStatus])
  @@index([season, publicationStatus, createdAt])
}

model FashionAccount {
  id          String                   @id @default(uuid())
  displayName String
  bio         String?
  avatarUrl   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  identities  FashionAccountIdentity[]
  posts       FashionCommunityPost[]
}

model FashionAccountIdentity {
  id               String         @id @default(uuid())
  fashionAccountId String
  provider         String
  providerUserId   String
  verifiedAt       DateTime
  createdAt        DateTime       @default(now())
  fashionAccount   FashionAccount @relation(fields: [fashionAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([fashionAccountId])
}

model FashionCommunityReaction {
  id                   String                @id @default(uuid())
  contentId            String
  postId               String?
  viewerId             String
  reaction             String
  createdAt            DateTime              @default(now())
  fashionCommunityPost FashionCommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([contentId, viewerId, reaction])
  @@index([contentId, reaction])
  @@index([postId, reaction])
  @@index([viewerId, reaction])
}

// One row per viewer per six-hour bucket. Used for real view/completion signals in
// feed ranking and creator statistics. Anonymous viewers are identified by the
// server-issued `ruda_fashion_viewer` cookie, never by client-supplied ids.
model FashionCommunityView {
  id                   String               @id @default(uuid())
  postId               String
  viewerId             String
  bucket               Int
  watchedMs            Int                  @default(0)
  completed            Boolean              @default(false)
  createdAt            DateTime             @default(now())
  fashionCommunityPost FashionCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerId, bucket])
  @@index([postId, createdAt])
  @@index([viewerId, createdAt])
}

// A post may showcase real RUDA products. The link is always resolved against the
// canonical Product table at read time so delisted products, stock changes and
// merchant authorization changes are reflected without copying product data.
model FashionCommunityPostProduct {
  id         String               @id @default(uuid())
  postId     String
  productId  String
  merchantId String
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  post       FashionCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@index([postId, sortOrder])
  @@index([productId])
  @@index([merchantId])
}

// Moderation queue for user-submitted content (posts and comments).
model FashionCommunityReport {
  id                String    @id @default(uuid())
  targetType        String
  targetId          String
  postId            String?
  commentId         String?
  reporterAccountId String?
  reporterViewerId  String
  reason            String
  detail            String?
  // pending | reviewing | resolved | rejected
  status            String    @default("pending")
  // none | remove_comment | unpublish_post
  action            String?
  resolution        String?
  handledBy         String?
  handledAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([targetType, targetId, reporterViewerId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Appeal filed by the author of moderated content. Kept separate from reports so
// the original moderation decision and its audit trail remain intact.
model FashionCommunityAppeal {
  id         String    @id @default(uuid())
  reportId   String?
  targetType String
  targetId   String
  accountId  String
  message    String
  // pending | accepted | rejected
  status     String    @default("pending")
  resolution String?
  handledBy  String?
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([accountId])
  @@index([targetType, targetId])
}

// Product taps from a post. Used for the real "商品点击" metric shown in the
// admin content console; deduplicated per viewer within a rolling hour.
model FashionCommunityProductClick {
  id        String   @id @default(uuid())
  postId    String
  productId String
  viewerId  String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([productId, createdAt])
  @@index([viewerId, createdAt])
}

// In-app activity notifications for likes, comments, replies, follows and
// moderation decisions. Recipients are always fashion accounts; anonymous viewers
// never receive notifications. Created server-side only.
model FashionCommunityNotification {
  id                 String    @id @default(uuid())
  recipientAccountId String
  actorAccountId     String?
  actorName          String
  type               String
  postId             String?
  postImage          String?
  commentId          String?
  preview            String?
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([recipientAccountId, createdAt])
  @@index([recipientAccountId, readAt])
}

model FashionCommunityBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
}

// Server-side drafts so a half-finished post survives reloads and devices.
// mediaItems references assets already stored by the fashion upload pipeline.
model FashionCommunityDraft {
  id         String   @id @default(uuid())
  accountId  String
  title      String?
  caption    String?
  hashtags   String[] @default([])
  category   String?
  city       String?
  season     String?
  mediaItems Json?
  productIds String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId, updatedAt])
}

// "Not interested" feedback. Persisted per account and excluded from that
// viewer's feed so the preference survives refresh and other devices.
model FashionCommunityHiddenPost {
  id        String   @id @default(uuid())
  accountId String
  postId    String
  createdAt DateTime @default(now())

  @@unique([accountId, postId])
  @@index([accountId, createdAt])
}

// Server-side taxonomy for the fashion community. Categories and tags used to
// live only as hard-coded arrays, which meant platform admins could not add,
// rename, disable or merge them. Terms are additive to the static fallback
// lists so existing rows keep working when the table is empty.
model FashionTaxonomyTerm {
  id         String   @id @default(uuid())
  // category | tag
  kind       String
  name       String
  slug       String
  // active | disabled | merged
  status     String   @default("active")
  mergedInto String?
  sortOrder  Int      @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([kind, name])
  @@unique([kind, slug])
  @@index([kind, status, sortOrder])
}

// Account-level moderation decisions. A report can target a post or comment,
// but repeat offenders need an account restriction with its own audit trail and
// lift history, independent from the report that triggered it.
model FashionCommunityAccountRestriction {
  id           String    @id @default(uuid())
  accountId    String
  // limited (cannot publish/comment) | suspended (also cannot interact)
  kind         String
  reason       String
  reportId     String?
  // active | lifted | expired
  status       String    @default("active")
  // JSON flags, e.g. { "canPost": false, "canComment": false, "canInteract": false }
  scope        Json?
  appliedBy    String
  appliedAt    DateTime  @default(now())
  expiresAt    DateTime?
  liftedBy     String?
  liftedAt     DateTime?
  liftedReason String?

  @@index([accountId, status])
  @@index([status, appliedAt])
}

// Media pipeline failures that admins must be able to see and act on: object
// storage persist errors, poster problems and broken media access. Written only
// by the server after a real failure, never by the client.
model FashionMediaEvent {
  id         String    @id @default(uuid())
  postId     String?
  accountId  String?
  // upload | poster | access | transcode
  stage      String
  // failed | resolved | ignored
  status     String    @default("failed")
  code       String
  detail     String?
  mediaUrl   String?
  attempts   Int       @default(1)
  lastError  String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([postId])
  @@index([stage, status])
}

// Shared, database-backed rate limit counters. Replaces the previous per-process
// Map so limits are enforced across worker processes and survive restarts.
model RateLimitCounter {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model FulfillmentShipment {
  id              String                    @id @default(uuid())
  orderId         String
  shipmentNo      String
  carrier         String?
  trackingNumber  String?
  status          String
  shippedAt       DateTime?
  deliveredAt     DateTime?
  proofOfDelivery String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items           FulfillmentShipmentItem[]
  trackingEvents  ShipmentTrackingEvent[]

  @@unique([orderId, shipmentNo])
  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
}

model FulfillmentShipmentItem {
  id                  String              @id @default(uuid())
  shipmentId          String
  orderItemId         String
  quantity            Int
  createdAt           DateTime            @default(now())
  orderItem           OrderItem           @relation(fields: [orderItemId], references: [id])
  fulfillmentShipment FulfillmentShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model InventoryBalance {
  id                String            @id @default(uuid())
  merchantId        String?
  variantId         String
  locationId        String
  onHandQuantity    Int               @default(0)
  reservedQuantity  Int               @default(0)
  inTransitQuantity Int               @default(0)
  version           Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  location          WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  merchant          Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([merchantId, locationId])
  @@index([variantId])
}

model InventoryMovement {
  id             String            @id @default(uuid())
  merchantId     String?
  variantId      String
  locationId     String
  quantity       Int
  movementType   String
  referenceType  String?
  referenceId    String?
  idempotencyKey String?           @unique
  operatorId     String?
  note           String?
  createdAt      DateTime          @default(now())
  location       WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  merchant       Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([movementType, createdAt])
  @@index([referenceType, referenceId])
  @@index([variantId, locationId, createdAt])
}

model Material {
  id           String                      @id @default(uuid())
  merchantId   String
  supplierId   String?
  code         String
  name         String
  category     String
  unit         String                      @default("meter")
  unitCost     Decimal                     @default(0) @db.Decimal(12, 4)
  reorderPoint Decimal                     @default(0) @db.Decimal(14, 3)
  leadTimeDays Int                         @default(0)
  status       String                      @default("active")
  notes        String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  merchant     Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  supplier     Supplier?                   @relation(fields: [supplierId], references: [id])
  balances     MaterialInventoryBalance[]
  movements    MaterialInventoryMovement[]
  bomItems     ProductBomItem[]

  @@unique([merchantId, code])
  @@index([merchantId, category, status])
  @@index([supplierId])
}

model MaterialInventoryBalance {
  id               String            @id @default(uuid())
  merchantId       String
  materialId       String
  locationId       String
  onHandQuantity   Decimal           @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal           @default(0) @db.Decimal(14, 3)
  version          Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  location         WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  material         Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, locationId])
  @@index([merchantId, locationId])
}

model MaterialInventoryMovement {
  id             String            @id @default(uuid())
  merchantId     String
  materialId     String
  locationId     String
  quantity       Decimal           @db.Decimal(14, 3)
  movementType   String
  referenceType  String?
  referenceId    String?
  idempotencyKey String?           @unique
  operatorId     String?
  note           String?
  createdAt      DateTime          @default(now())
  location       WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  material       Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, locationId, createdAt])
  @@index([merchantId, createdAt])
  @@index([referenceType, referenceId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
