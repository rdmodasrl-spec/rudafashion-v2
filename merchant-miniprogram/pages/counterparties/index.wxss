}

.record-card,
.state-card,
.error-card,
.inline-error {
  border-color: #e5e5e5;
  border-radius: 18rpx;
  box-shadow: 0 7rpx 20rpx rgba(35, 31, 25, .055), 0 2rpx 5rpx rgba(35, 31, 25, .02), inset 0 1rpx 0 #fff;
}

.record-card {
  transition: transform var(--motion-fast), border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.record-card:active {
  transform: translateY(2rpx) scale(.995);
  border-color: #d3cec4;
  box-shadow: 0 3rpx 9rpx rgba(35, 31, 25, .045), inset 0 1rpx 2rpx rgba(35, 31, 25, .035);
}

.record-name,
.section-title,
.empty-title {
  color: #242321;
}

.record-meta,
.empty-caption {
  color: #716d66;
}

.search-box,
.link-picker,
.form-input,
.form-textarea {
  border-color: #e2e2e2;
  box-shadow: inset 0 1rpx 2rpx rgba(35, 31, 25, .025), 0 1rpx 0 #fff;
}

.search-box:focus-within,
.form-input:focus,
.form-textarea:focus {
  border-color: #9a9387;
  box-shadow: 0 0 0 4rpx rgba(96, 82, 59, .08), 0 4rpx 12rpx rgba(35, 31, 25, .045);
}

.add-button,
.save-button {
  background: linear-gradient(180deg, #3b3935 0%, #1d1b19 100%);
  box-shadow: 0 6rpx 14rpx rgba(29, 27, 25, .17), inset 0 1rpx 0 rgba(255, 255, 255, .16);
  transition: transform var(--motion-fast), box-shadow var(--motion-fast), opacity var(--motion-fast);
}

.edit-button,
.small-button,
.text-button,
.cancel-button {
  border-color: #dedbd5;
  background: linear-gradient(180deg, #fff 0%, #f7f7f7 100%);
  color: #393631;
  box-shadow: 0 3rpx 8rpx rgba(35, 31, 25, .055), inset 0 1rpx 0 #fff;
}

.add-button:active,
.save-button:active,
.edit-button:active,
.small-button:active,
.text-button:active,
.cancel-button:active {
  transform: translateY(2rpx) scale(.985);
  box-shadow: inset 0 2rpx 5rpx rgba(35, 31, 25, .11);
}

.editor-sheet,
.detail-sheet {
  border: 1rpx solid #e5e5e5;
  box-shadow: 0 -12rpx 36rpx rgba(25, 23, 20, .14);
}

.history-right {
  flex: 0 0 auto;
  text-align: right;
}

.history-status {
  color: #777;
  font-size: 20rpx;
}

.history-amount {
  margin-top: 5rpx;
  color: #333;
  font-size: 22rpx;
  font-weight: 600;
}

.detail-done {
  flex: 1;
}

page,
.counterparty-page {
  background: #f6f6f6;
  color: #1d1d1d;
}

.counterparty-page {
  padding: 28rpx 28rpx calc(145rpx + env(safe-area-inset-bottom));
}

.counterparty-page .page-header {
  min-height: 62rpx;
  margin-bottom: 16rpx;
}

.counterparty-page .page-title {
  color: #171717;
  font-size: 36rpx;
}

.counterparty-page,
.counterparty-page button {
  font-family: inherit;
}

.counterparty-page .add-button,
.counterparty-page .save-button,
.counterparty-page .cancel-button,
.counterparty-page .edit-button,
.counterparty-page .small-button,
.counterparty-page .text-button {
  font-size: 23rpx;
}

.counterparty-page .tab-switch {
  margin-bottom: 18rpx;
  border-color: #e7e7e7;
  background: #ededed;
  box-shadow: none;
}

.counterparty-page .tab-item {
  padding: 16rpx 8rpx;
  color: #666;
}

.counterparty-page .tab-item.tab-active {
  background: #171717;
  color: #fff;
  box-shadow: none;
}

.counterparty-page .panel-heading {
  margin-bottom: 12rpx;
}

.counterparty-page .section-title {
  color: #202020;
  font-size: 27rpx;
}

.counterparty-page .search-box {
  height: 72rpx;
  margin-bottom: 14rpx;
  background: #ededed;
  box-shadow: none;
}

.counterparty-page .record-list {
  border-color: #ededed;
  border-radius: 12rpx;
  box-shadow: none;
}

.counterparty-page .record-card {
  min-height: 104rpx;
  padding: 15rpx 17rpx;
}

.counterparty-page .record-name {
  color: #202020;
  font-size: 23rpx;
}

.counterparty-page .record-meta {
  margin-top: 5rpx;
  color: #777;
  font-size: 18rpx;
}

.counterparty-page .record-actions {
  min-height: 38rpx;
  margin-top: 5rpx;
  padding-top: 3rpx;
}

.counterparty-page .summary-grid {
  gap: 0;
  padding: 10rpx 6rpx;
  border: 0;
  border-radius: 12rpx;
  background: #171717;
  box-shadow: none;
}

.counterparty-page .summary-card,
.counterparty-page .summary-card--primary {
  min-height: 78rpx;
  padding: 8rpx 14rpx;
  border: 0;
  border-right: 1rpx solid rgba(255, 255, 255, .16);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.counterparty-page .summary-card:last-child {
  border-right: 0;
}

.counterparty-page .summary-label,
.counterparty-page .summary-card--primary .summary-label {
  color: #c9c9c9;
  font-size: 18rpx;
}

.counterparty-page .summary-value,
.counterparty-page .summary-card--primary .summary-value {
  color: #fff;
  font-size: 30rpx;
}

.counterparty-page .add-button,
.counterparty-page .save-button {
  border-radius: 999rpx;
  background: #151515;
  box-shadow: none;
}

.counterparty-page .detail-card {
  padding: 20rpx;
  border-color: #ededed;
  border-radius: 12rpx;
  box-shadow: none;
}

.counterparty-page .detail-profile {
  gap: 14rpx;
  padding-bottom: 15rpx;
}

.counterparty-page .detail-avatar {
  width: 84rpx;
  height: 84rpx;
  flex-basis: 84rpx;
  border-radius: 16rpx;
}

.counterparty-page .detail-name {
  color: #1b1b1b;
  font-size: 26rpx;
}

.counterparty-page .detail-role {
  background: #ededed;
  color: #454545;
}

.counterparty-page .detail-info-row {
  padding: 12rpx 0;
  border-color: #ededed;
}

.counterparty-page .detail-info-label,
.counterparty-page .detail-info-value {
  font-size: 19rpx;
}

.detail-stats {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  background: #ededed;
}

.detail-stat {
  min-width: 0;
  flex: 1;
  padding: 0 8rpx;
  border-right: 1rpx solid #d8d8d8;
}

.detail-stat:last-child {
  border-right: 0;
}

.detail-stat-label,
.detail-stat-value {
  display: block;
}

.detail-stat-label {
  overflow: hidden;
  color: #737373;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-stat-value {
  overflow: hidden;
  margin-top: 6rpx;
  color: #1b1b1b;
  font-size: 20rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counterparty-page .history-heading {
  margin: 20rpx 2rpx 8rpx;
}

.counterparty-page .history-row {
  padding: 15rpx 4rpx;
  border-bottom: 1rpx solid #e7e7e7;
}

.counterparty-page .history-id {
  color: #242424;
  font-size: 20rpx;
}

.counterparty-page .history-amount {
  color: #202020;
}

.counterparty-page .tab-switch {
  border-radius: 12rpx;
}

.counterparty-page .tab-item,
.counterparty-page .record-card,
.counterparty-page .add-button,
.counterparty-page .save-button {
  transition: background-color var(--motion-fast), opacity var(--motion-fast);
}

.counterparty-page .record-card:active {
  transform: none;
  box-shadow: none;
}
