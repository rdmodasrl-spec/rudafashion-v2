  id                             String                           @id @default(uuid())
  name                           String
  companyLegalName               String
  code                           String                           @unique
  storeLookupCode                String                           @unique @default(dbgenerated("lpad(nextval('merchant_store_lookup_code_seq'::regclass)::text, 6, '0'::text)"))
  country                        String
  country_it                     String?
  country_zh                     String?
  city                           String
  city_it                        String?
  city_zh                        String?
  showroomAddress                String
  showroomArea                   String
  showroomArea_it                String?
  showroomArea_zh                String?
  showroomImage                  String
  showroomPanoramicImages        String?
  storefrontMediaItems           Json?
