  merchantZone                   String                           @default("iolo")
  platformFeeRate                Decimal                          @default(0.08) @db.Decimal(6, 4)
  vatNumber                      String                           @default("")
  businessType                   String                           @default("brand_supplier")
  settings                       String                           @default("{}")
  companyId                      String?
  storefrontVideo                String                           @default("")
  storefrontSeoTitle             String                           @default("") @db.VarChar(70)
  storefrontSeoDescription       String                           @default("") @db.VarChar(320)
  storefrontShippingPolicy       String                           @default("")
  storefrontReturnsPolicy        String                           @default("")
  storefrontReturnAddress        String                           @default("")
  storefrontAiEnabled            Boolean                          @default(false)
  storefrontAiActivatedAt        DateTime?
  storefrontAiActivatedBy        String?
  industry                       String                           @db.VarChar(32)
  industrySource                 String                           @default("LEGACY_INFERENCE") @db.VarChar(32)
