.home-industry-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin: 0 var(--space-lg) var(--space-lg);
  padding: var(--space-lg);
  background: var(--paper-secondary);
  border: var(--border-fine);
  border-radius: var(--radius-lg);
}

.home-industry-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home-industry-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--ink-primary);
}

.home-industry-desc {
  margin-top: 4rpx;
  font-size: var(--font-size-xs);
  color: var(--ink-tertiary);
}

.dashboard-screen {
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 头部样式 */
.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-xl);
}

.merchant-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-wrapper {
  margin-right: var(--space-md);
}

.merchant-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--paper-tertiary);
  border: var(--border-fine);
}

.merchant-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-secondary);
}

.merchant-details {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.merchant-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--ink-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-tag {
  font-size: 18rpx;
  color: var(--ink-quaternary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.header-actions {
  display: flex;
  gap: var(--space-sm);
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  background: var(--paper-tertiary);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: none;
}

.dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--ink-primary);
  border-radius: 50%;
  border: 4rpx solid var(--paper-tertiary);
}

/* 搜索框升级 */
.search-section {
  margin-bottom: var(--space-xl);
}

.modern-search {
  height: 104rpx;
  background: var(--paper-tertiary);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  padding: 0 var(--space-lg);
  transition: all 0.3s ease;
}

.search-icon-inner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--ink-quaternary);
  border-radius: 50%;
  margin-right: var(--space-md);
  position: relative;
}

.search-icon-inner::after {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 3rpx;
  background: var(--ink-quaternary);
  bottom: -4rpx;
  right: -4rpx;
  transform: rotate(45deg);
}

.search-input-field {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--ink-primary);
}

.search-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.05);
  z-index: 100;
  backdrop-filter: blur(4px);
}

.search-results-panel {
  position: absolute;
  top: 240rpx;
  left: var(--space-lg);
  right: var(--space-lg);
  background: var(--paper-primary);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-floating);
  max-height: 60vh;
  overflow: hidden;
}

/* 快捷入口 */
.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-sm);
  margin-bottom: var(--space-xl);
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.shortcut-icon {
  width: 100rpx;
  height: 100rpx;
  background: var(--paper-tertiary);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xs);
  transition: all 0.2s ease;
}

.shortcut-item text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-secondary);
}

/* 业务卡片 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--space-md);
}

.view-all {
  font-size: var(--font-size-xs);
  color: var(--ink-quaternary);
  font-weight: 600;
}

.pending-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--ink-primary);
  color: var(--paper-primary);
  border: none;
}

.pending-title {
  display: block;
  font-size: var(--font-size-md);
  font-weight: 600;
  margin-bottom: 4rpx;
}

.pending-subtitle {
  font-size: 20rpx;
  opacity: 0.6;
}

.pending-badge {
  width: 60rpx;
  height: 60rpx;
  background: var(--paper-primary);
  color: var(--ink-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
}

/* 订单列表 */
.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-main {
  display: flex;
  flex-direction: column;
}

.order-no {
  font-size: var(--font-size-sm);
  font-weight: 700;
  margin-bottom: 4rpx;
}

.order-customer {
  font-size: 22rpx;
  color: var(--ink-tertiary);
}

.order-side {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.order-price {
  font-size: var(--font-size-sm);
  font-weight: 700;
}

/* 经营看板 */
.metrics-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
}

.metric-card {
  display: flex;
  flex-direction: column;
}

.metric-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  margin-top: var(--space-xs);
  letter-spacing: -1rpx;
}

/* 图标辅助类 (纯 CSS 实现) */
.icon-bell, .icon-msg, .icon-all, .icon-price, .icon-stock, .icon-plus {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid currentColor;
  position: relative;
}

.icon-bell { border-radius: 18rpx 18rpx 6rpx 6rpx; }
.icon-msg { border-radius: 6rpx; }
.icon-all { border-radius: 4rpx; transform: rotate(45deg); width: 24rpx; height: 24rpx; }
.icon-price { border-radius: 50%; }
.icon-stock { border-width: 0 0 3rpx 3rpx; width: 30rpx; height: 30rpx; }
.icon-plus { border: none; }
.icon-plus::before, .icon-plus::after {
  content: ''; position: absolute; background: currentColor;
}
.icon-plus::before { width: 36rpx; height: 4rpx; top: 16rpx; left: 0; }
.icon-plus::after { width: 4rpx; height: 36rpx; top: 0; left: 16rpx; }

/* 错误提示框 */
.error-toast {
  position: fixed;
  bottom: 120rpx;
  left: var(--space-lg);
  right: var(--space-lg);
  background: var(--accent-error);
  color: #fff;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  text-align: center;
  box-shadow: var(--shadow-floating);
  z-index: 1000;
}

.merchant-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.merchant-logo,
.merchant-logo-fallback {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border: var(--border-fine);
  border-radius: var(--radius-md);
  background: var(--paper-tertiary);
}

.merchant-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-secondary);
  font-size: 36rpx;
  font-weight: 700;
}

.merchant-meta {
  margin-top: 6rpx;
  color: var(--ink-quaternary);
  font-size: var(--font-size-xs);
}

.action-icon-box {
  position: relative;
  display: flex;
  min-width: 72rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border-radius: var(--radius-sm);
  background: var(--paper-tertiary);
  color: var(--ink-secondary);
  font-size: var(--font-size-xs);
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  box-sizing: border-box;
  padding: 2rpx 6rpx;
  border-radius: var(--radius-full);
  background: var(--accent-error);
  color: #fff;
  font-size: 18rpx;
  line-height: 24rpx;
  text-align: center;
}

.search-bar { position: relative; margin-bottom: var(--space-lg); }
.search-input { margin: 0; }

.search-results {
  position: absolute;
  z-index: 20;
  top: 100%;
  right: 0;
  left: 0;
  max-height: 55vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: var(--space-sm);
  border: var(--border-fine);
}

.search-status {
  padding: var(--space-md);
  color: var(--ink-quaternary);
  font-size: var(--font-size-sm);
  text-align: center;
}

.search-status.error { color: var(--accent-error); }
.search-list { max-height: 50vh; }

.search-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: var(--border-fine);
}

.search-item:last-child { border-bottom: 0; }
.search-item-image { width: 76rpx; height: 90rpx; flex: 0 0 76rpx; border-radius: var(--radius-xs); background: var(--paper-tertiary); }
.search-item-info { min-width: 0; flex: 1; }
.item-title { display: block; color: var(--ink-primary); font-size: var(--font-size-sm); font-weight: 600; }
.item-meta { display: block; margin-top: 4rpx; color: var(--ink-quaternary); font-size: var(--font-size-xs); }

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.action-card { min-height: 112rpx; margin: 0; padding: var(--space-md); }
.action-title { display: block; color: var(--ink-primary); font-size: var(--font-size-sm); font-weight: 700; }
.action-desc { display: block; margin-top: 6rpx; color: var(--ink-quaternary); font-size: var(--font-size-xs); }

.notification-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
  background: var(--ink-primary);
  color: #fff;
}

.notification-text { font-size: var(--font-size-sm); }
.notification-link { color: #fff; font-size: var(--font-size-xs); }

.recent-orders,
.business-metrics { margin-top: var(--space-lg); }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.section-title { color: var(--ink-primary); font-size: var(--font-size-md); font-weight: 700; }
.section-link { color: var(--ink-quaternary); font-size: var(--font-size-xs); }

.order-card { margin-bottom: var(--space-sm); }
.order-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
.order-row + .order-row { margin-top: var(--space-sm); }
.order-row .item-meta { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-status { flex: 0 0 auto; color: var(--ink-tertiary); font-size: var(--font-size-xs); }

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-sm);
}

.metric-item { min-width: 0; margin: 0; }
.metric-value { display: block; overflow: hidden; margin-top: var(--space-xs); color: var(--ink-primary); font-size: var(--font-size-lg); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }

.merchant-header {
  min-height: 112rpx;
  margin-bottom: var(--space-md);
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.merchant-name {
  font-size: 44rpx;
  line-height: 1.2;
}

.dashboard-bell {
  position: relative;
  display: flex;
  width: 96rpx;
