.product-detail-screen { padding: 18rpx 24rpx calc(118rpx + env(safe-area-inset-bottom)); }
.detail-state { display: flex; min-height: 180rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; padding: 24rpx; color: #737373; font-size: 23rpx; text-align: center; }
.detail-error, .detail-inventory-error { color: #b42318; }
.detail-header { position: sticky; top: 0; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: -18rpx -24rpx 12rpx; padding: 22rpx 24rpx 18rpx; border-bottom: 1rpx solid #eee; background: rgba(255, 255, 255, .97); }
.detail-header-copy { min-width: 0; flex: 1; }
.detail-header-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.detail-header-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 4rpx; }
.detail-header-name { display: block; margin-top: 6rpx; color: #222; font-size: 31rpx; font-weight: 600; line-height: 1.3; }
.detail-header-category { display: block; margin-top: 4rpx; color: #777; font-size: 20rpx; }
.detail-private { padding: 4rpx 10rpx; border-radius: 999rpx; background: #f2f2f2; color: #555; font-size: 17rpx; }
.detail-inventory-status { padding: 4rpx 10rpx; border-radius: 999rpx; background: #f2f2f2; color: #555; font-size: 17rpx; }
.detail-inventory-status.stock-good { background: #f2f2f2; color: #555; }
.detail-inventory-status.stock-low, .detail-inventory-status.stock-empty { background: #e9e9e9; color: #333; }
.detail-header-edit { width: auto; min-height: 64rpx; margin: 0; padding: 0 14rpx; border: 0; background: transparent; color: #666; font-size: 20rpx; line-height: 64rpx; }
.detail-back { display: flex; width: 68rpx; height: 68rpx; flex: 0 0 68rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 14rpx; background: #f4f4f4; color: #666; font-size: 40rpx; line-height: 1; }
.detail-cover { display: block; width: 100%; height: 470rpx; border-radius: 12rpx; background: #f0f0f0; }
.detail-cover-placeholder { display: flex; align-items: center; justify-content: center; color: #a3a3a3; font-size: 24rpx; letter-spacing: 3rpx; }
.detail-gallery { margin-top: 8rpx; white-space: nowrap; }
.detail-gallery-row { display: flex; gap: 8rpx; }
.detail-gallery-item { display: inline-flex; width: 96rpx; height: 112rpx; overflow: hidden; border: 2rpx solid transparent; border-radius: 7rpx; background: #f3f3f3; }
.detail-gallery-selected { border-color: #171717; }
.detail-gallery-image { width: 100%; height: 100%; }
.detail-gallery-video { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #525252; font-size: 18rpx; }
.detail-card { margin-top: 10rpx; padding: 16rpx; border-radius: 12rpx; background: #fff; }
.detail-style { display: block; color: #777; font-size: 20rpx; }
.detail-status { flex: 0 0 auto; padding: 4rpx 10rpx; border-radius: 999rpx; background: #f2f2f2; color: #555; font-size: 18rpx; }
.detail-price-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.detail-price-cell { min-width: 0; padding: 14rpx; border-radius: 12rpx; background: #f7f7f7; }
.detail-price-label { display: block; color: #777; font-size: 19rpx; }
.detail-price { display: block; overflow: hidden; margin-top: 6rpx; color: #222; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.detail-price-secondary { display: block; overflow: hidden; margin-top: 7rpx; color: #333; font-size: 23rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.detail-variant-summary { display: block; margin-top: 7rpx; color: #888; font-size: 19rpx; }
.detail-info-card { margin-top: 16rpx; padding: 18rpx; border: 1rpx solid #e5e5e5; border-radius: 12rpx; background: #fff; }
.detail-info-title { display: block; color: #222; font-size: 23rpx; font-weight: 600; }
.detail-color-size { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 12rpx; padding: 14rpx; border: 1rpx solid #e5e5e5; border-radius: 12rpx; }
.detail-color-size view { min-width: 0; }
.detail-color-size text { display: block; overflow: hidden; color: #777; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-color-size text + text { margin-top: 5rpx; color: #333; font-size: 21rpx; font-weight: 500; }
.detail-specs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7rpx 12rpx; margin-top: 12rpx; color: #555; font-size: 20rpx; line-height: 1.4; }
.detail-description { display: block; margin-top: 10rpx; color: #777; font-size: 20rpx; line-height: 1.5; white-space: pre-wrap; }
.detail-section-head { display: flex; justify-content: space-between; margin: 18rpx 2rpx 8rpx; color: #262626; font-size: 22rpx; font-weight: 600; }
.detail-section-head text + text { color: #888; font-size: 19rpx; font-weight: 400; }
.detail-inventory-error, .detail-inventory-note { display: block; margin: 7rpx 2rpx; color: #888; font-size: 18rpx; line-height: 1.4; }
.detail-inventory-error { color: #b42318; }
.detail-sku { display: flex; min-height: 82rpx; align-items: center; justify-content: space-between; gap: 10rpx; padding: 10rpx 12rpx; border-bottom: 1rpx solid #f0f0f0; background: #fff; }
.detail-sku:first-of-type { border-radius: 12rpx 12rpx 0 0; }
.detail-sku:last-child { border-bottom: 0; border-radius: 0 0 12rpx 12rpx; }
.detail-sku-selected { background: #f5f5f5; box-shadow: inset 3rpx 0 #171717; }
.detail-sku-copy { min-width: 0; flex: 1; }
.detail-sku-name { display: block; color: #262626; font-size: 21rpx; font-weight: 500; }
.detail-sku-code { display: block; overflow: hidden; margin-top: 4rpx; color: #888; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-sku-values { display: flex; min-width: 130rpx; flex-direction: column; align-items: flex-end; gap: 5rpx; }
.detail-sku-stock { color: #525252; font-size: 18rpx; font-weight: 500; text-align: right; }
.detail-sku-price { color: #888; font-size: 17rpx; }
.detail-show-skus { width: 100%; min-height: 66rpx; margin: 0; border: 0; border-bottom: 1rpx solid #eee; border-radius: 0 0 12rpx 12rpx; background: #fff; color: #555; font-size: 20rpx; line-height: 66rpx; }
.detail-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; display: flex; gap: 10rpx; padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eee; background: rgba(255, 255, 255, .97); }
.detail-edit, .detail-share { flex: 1; min-height: 68rpx; margin: 0; border: 0; border-radius: 9rpx; font-size: 22rpx; font-weight: 600; line-height: 68rpx; }
.detail-edit { background: #171717; color: #fff; }
.detail-share { border: 1rpx solid #dedede; background: #fff; color: #292929; }
.detail-retry { width: auto; min-height: 52rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid #dedede; border-radius: var(--radius-control); background: #fff; color: #333; font-size: 20rpx; line-height: 50rpx; }
