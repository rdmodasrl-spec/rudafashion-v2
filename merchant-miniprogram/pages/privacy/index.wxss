.privacy-screen {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 30rpx 30rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: var(--ink-primary);
}

.privacy-intro,
.privacy-section,
.privacy-footer {
  box-sizing: border-box;
  margin-bottom: 0;
  padding: 24rpx 0;
  border: 0;
  border-bottom: 1rpx solid #e8e8e8;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.privacy-intro {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 4rpx;
  padding-bottom: 22rpx;
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}

.privacy-updated {
  color: var(--ink-quaternary);
  font-size: 20rpx;
}

.privacy-heading {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.privacy-item + .privacy-item {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
}

.privacy-item-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.privacy-copy,
.privacy-footer text {
  color: #4a4a4a;
  font-size: 22rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.privacy-footer {
  border-bottom: 0;
  color: #555;
}

.legal-document-link {
  display: block;
  margin: 18rpx 0 0;
  padding: 20rpx 0;
  border: 0;
  border-bottom: 1rpx solid #e8e8e8;
  border-radius: 0;
  background: transparent;
  color: #1d1b19;
  font-size: 23rpx;
  font-weight: 600;
  text-decoration: none;
}

.privacy-title {
  color: #1d1b19;
  font-size: 31rpx;
}

.privacy-updated {
  color: #666;
}

.privacy-item-title {
  color: #282622;
}

.privacy-copy,
.privacy-footer text {
  word-break: normal;
}
