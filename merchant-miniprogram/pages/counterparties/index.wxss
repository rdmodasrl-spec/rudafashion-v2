page {
  min-height: 100%;
  background: #292929;
}

.counterparty-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  color: #222;
  background: #292929;
}

.page-header {
  margin: 0 2rpx 24rpx;
}

.page-title {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #c7c7c7;
  font-size: 23rpx;
}

.tab-switch {
  display: flex;
  margin-bottom: 24rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: #3a3a3a;
}

.tab-item {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 9rpx;
  color: #dedede;
  font-size: 25rpx;
  text-align: center;
}

.tab-active {
  background: #fff;
  color: #222;
  font-weight: 600;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 2rpx 16rpx;
}

.section-title {
  display: block;
  color: #222;
  font-size: 29rpx;
  font-weight: 600;
}

.section-caption {
  display: block;
  margin-top: 5rpx;
  color: #858585;
  font-size: 21rpx;
}

.add-button {
  flex: 0 0 auto;
  height: 62rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 9rpx;
  background: #1d1b19;
  color: #fff;
  font-size: 23rpx;
  line-height: 62rpx;
}

.search-box {
  display: flex;
  height: 76rpx;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 0 18rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  background: #fff;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  color: #8b8b8b;
  opacity: .68;
}

.search-box input {
  min-width: 0;
  flex: 1;
  color: #222;
  font-size: 24rpx;
}

.clear-search {
  padding: 10rpx 0 10rpx 10rpx;
  color: #1d1b19;
  font-size: 21rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-card {
  padding: 18rpx 20rpx 12rpx;
  border: 1rpx solid #efefef;
  border-radius: 12rpx;
  background: #fff;
}

.record-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-name {
  display: block;
  overflow: hidden;
  color: #222;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  display: block;
  overflow: hidden;
  margin-top: 5rpx;
  color: #777;
  font-size: 21rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-arrow {
  color: #aaa;
  font-size: 36rpx;
}

.record-actions {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.identity-tag,
.shared-tag {
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  background: #f2f2f2;
  color: #4d4d4d;
  font-size: 19rpx;
}

.supplier-tag {
  background: #f0f2f3;
  color: #58616a;
}

.shared-tag {
  background: #f3f3f3;
  color: #777;
}

.edit-button,
.small-button,
.text-button {
  min-width: 0;
  height: 50rpx;
  margin: 0 0 0 auto;
  padding: 0 15rpx;
  border: 1rpx solid #e4e4e4;
  border-radius: 8rpx;
  background: #fff;
  color: #444;
  font-size: 21rpx;
  line-height: 48rpx;
}

.state-card,
.error-card,
.inline-error {
  padding: 30rpx 22rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  background: #fff;
  color: #777;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.compact-state {
  padding: 22rpx 18rpx;
}

.empty-state {
  padding: 46rpx 24rpx;
}

.empty-title {
  display: block;
  color: #333;
  font-size: 27rpx;
  font-weight: 600;
}

.empty-caption {
  display: block;
  margin: 10rpx 0 22rpx;
  color: #888;
  font-size: 21rpx;
}

.empty-add {
  display: inline-block;
}

.state-action {
  display: block;
  margin-top: 8rpx;
  color: #1d1b19;
}

.error-card,
.inline-error {
  color: #9a3933;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  text-align: left;
}

.text-button {
  flex: 0 0 auto;
  color: #1d1b19;
}

.overlay {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, .5);
}

.editor-sheet,
.detail-sheet {
  display: flex;
  width: 100%;
  max-height: 88vh;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 22rpx 22rpx 0 0;
  background: #fff;
}

.sheet-heading {
  display: flex;
  height: 92rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.sheet-title {
  color: #222;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  color: #777;
  font-size: 44rpx;
  line-height: 52rpx;
  text-align: center;
}

.sheet-content {
  min-height: 0;
  flex: 1;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.link-picker {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  gap: 10rpx;
  padding: 0 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 9rpx;
  background: #fafafa;
}

.link-picker .field-label {
  flex: 0 0 auto;
}

.picker-value {
  overflow: hidden;
  flex: 1;
  color: #555;
  font-size: 21rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  color: #999;
  font-size: 30rpx;
}

.form-hint {
  display: block;
  margin: 9rpx 4rpx 16rpx;
  color: #888;
  font-size: 20rpx;
  line-height: 1.5;
}

.form-field {
  margin-bottom: 17rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #555;
  font-size: 22rpx;
}

.required {
  color: #b4473d;
}

.form-input,
.form-textarea {
  width: 100%;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #e7e7e7;
  border-radius: 9rpx;
  background: #fff;
  color: #222;
  font-size: 24rpx;
}

.form-input {
  line-height: 76rpx;
}

.form-textarea {
  min-height: 130rpx;
  padding: 15rpx 18rpx;
  line-height: 1.5;
}

.form-row {
  display: flex;
  gap: 14rpx;
}

.half-field {
  min-width: 0;
  flex: 1;
}

.form-error {
  margin: 8rpx 0 18rpx;
  color: #a13b31;
  font-size: 22rpx;
}

.sheet-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 14rpx;
  padding: 16rpx 30rpx 18rpx;
  border-top: 1rpx solid #eee;
  background: #fff;
}

.cancel-button,
.save-button {
  height: 78rpx;
  margin: 0;
  border-radius: 9rpx;
  font-size: 24rpx;
  line-height: 78rpx;
}

.cancel-button {
  flex: 1;
  border: 1rpx solid #e5e5e5;
  background: #fff;
  color: #555;
}

.save-button {
  flex: 1.4;
  background: #1d1b19;
  color: #fff;
}

.detail-card {
  padding: 22rpx;
  border-radius: 11rpx;
  background: #f7f7f7;
}

.detail-name {
  display: block;
  margin-bottom: 10rpx;
  color: #222;
  font-size: 29rpx;
  font-weight: 600;
}

.detail-line {
  display: block;
  margin-top: 7rpx;
  color: #666;
  font-size: 22rpx;
  line-height: 1.5;
}

.history-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 12rpx;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  padding: 17rpx 4rpx;
  border-bottom: 1rpx solid #eee;
}

.history-id,
.history-date,
.history-status,
.history-amount {
  display: block;
}

.history-id {
  max-width: 400rpx;
  overflow: hidden;
  color: #333;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counterparty-page {
  background: #f4f4f4;
  color: #1d1b19;
}

.counterparty-page .tab-switch {
  border: 1rpx solid #e8e8e8;
  background: #ebebeb;
}

.counterparty-page .tab-item {
  color: #666;
}

.counterparty-page .tab-item.tab-active {
  background: #1d1b19;
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(29, 27, 25, .16);
}

.counterparty-page .panel-heading {
  margin: 0 2rpx 14rpx;
}

.counterparty-page .panel-heading .add-button {
  width: auto;
  min-width: 116rpx;
  margin-left: auto;
}

.counterparty-page .section-title {
  color: #1d1b19;
}

.counterparty-page .search-box {
  height: 76rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ededed;
  box-shadow: none;
}

.counterparty-page .record-list {
  gap: 0;
  overflow: hidden;
  border: 1rpx solid #ececec;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(20, 20, 20, .04);
}

.counterparty-page .record-card {
  display: flex;
  min-height: 116rpx;
  flex-direction: column;
  justify-content: center;
  padding: 18rpx 20rpx;
  border: 0;
  border-bottom: 1rpx solid #ededed;
  border-radius: 0;
  background: #fff;
}

.counterparty-page .record-card:last-child {
  border-bottom: 0;
}

.counterparty-page .record-main {
  align-items: center;
  gap: 16rpx;
}

.record-avatar,
.detail-avatar {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #e9e9e9;
  color: #272727;
  font-size: 29rpx;
  font-weight: 700;
}

.record-avatar--supplier {
  background: #f0f0f0;
}

.counterparty-page .record-copy {
  align-self: center;
}

.counterparty-page .record-name {
  font-size: 25rpx;
  font-weight: 650;
}

.counterparty-page .record-meta {
  color: #777;
}

.counterparty-page .record-actions {
  min-height: 44rpx;
  margin: 9rpx 0 0 92rpx;
  padding: 7rpx 0 0;
  border-top: 0;
}

.counterparty-page .identity-tag,
.counterparty-page .shared-tag {
  background: #f1f1f1;
  color: #555;
}

.summary-grid {
  display: flex;
  gap: 14rpx;
  margin: 4rpx 0 18rpx;
}

.summary-card {
  display: flex;
  min-height: 100rpx;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border: 1rpx solid #eaeaea;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 3rpx 10rpx rgba(20, 20, 20, .035);
}

.summary-card--primary {
  border-color: #1d1b19;
  background: #1d1b19;
}

.summary-label {
  color: #777;
  font-size: 19rpx;
}

.summary-value {
  color: #1d1b19;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.1;
}

.summary-card--primary .summary-label,
.summary-card--primary .summary-value {
  color: #fff;
}

.counterparty-page .detail-card {
  padding: 24rpx;
  border: 1rpx solid #ececec;
  border-radius: 20rpx;
  background: #fff;
}

.detail-profile {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ededed;
}

.detail-avatar {
  width: 94rpx;
  height: 94rpx;
  flex-basis: 94rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
}

.detail-profile-copy {
  min-width: 0;
  flex: 1;
}

.counterparty-page .detail-name {
  margin: 0;
  color: #1d1b19;
  font-size: 29rpx;
  font-weight: 700;
}

.detail-role {
  display: inline-block;
  margin-top: 8rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #efefef;
  color: #555;
  font-size: 18rpx;
}

.detail-info-list {
  padding-top: 8rpx;
}

.detail-info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-info-row:last-child {
  border-bottom: 0;
}

.detail-info-label {
  flex: 0 0 125rpx;
  color: #858585;
  font-size: 21rpx;
}

.detail-info-value {
  min-width: 0;
  color: #242424;
  font-size: 21rpx;
  text-align: right;
  word-break: break-all;
}

.counterparty-page .history-heading {
  margin-top: 24rpx;
}

.counterparty-page .history-row {
  padding: 18rpx 4rpx;
}

.counterparty-page .error-card,
.counterparty-page .inline-error {
  border: 1rpx solid #efd3d1;
  background: #fff5f4;
  color: #9a302a;
}

