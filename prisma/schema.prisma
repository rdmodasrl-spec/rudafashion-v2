  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([merchantId])
  @@index([status])
}

model WarehouseLocation {
  id                        String                      @id @default(uuid())
  merchantId                String?
  code                      String
  name                      String
  type                      String
  country                   String?
  city                      String?
  isActive                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  inventoryBalance          InventoryBalance[]
  inventoryMovement         InventoryMovement[]
  materialInventoryBalance  MaterialInventoryBalance[]
  materialInventoryMovement MaterialInventoryMovement[]
  productionWorkOrder       ProductionWorkOrder[]
  merchant                  Merchant?                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, code])
  @@index([merchantId])
  @@index([type, isActive])
}

// ---------------------------------------------------------------------------
// RUDA 智能生产链 v2（外发加工记账与月度结算）
// 商品、SKU、员工、权限、审计与应用安装复用既有权威模型；
// 本组表只负责加工单、取货交接、送货验收、月度结算、付款与单据留言。
// ---------------------------------------------------------------------------

model ProductionFactory {
  id               String                    @id @default(uuid())
  merchantId       String
  name             String
  contactName      String?
  phone            String?
  email            String?
  address          String?
  settlementTerms  String?
  status           String                    @default("invited")
  inviteTokenHash  String?                   @unique
  inviteExpiresAt  DateTime?
  inviteAcceptedAt DateTime?
  notes            String?
  version          Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  merchant         Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  members          ProductionFactoryMember[]
  orders           ProductionOrder[]
  pickups          ProductionPickup[]
  deliveries       ProductionDelivery[]
  statements       ProductionStatement[]
  payments         ProductionPayment[]
  messages         ProductionMessage[]

  @@unique([merchantId, name])
  @@index([merchantId, status])
}

model ProductionFactoryMember {
  id           String            @id @default(uuid())
  factoryId    String
  name         String
  email        String
  passwordHash String
  role         String            @default("owner")
  active       Boolean           @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  factory      ProductionFactory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@unique([factoryId, email])
  @@index([email])
}

model ProductionOrder {
  id              String                    @id @default(uuid())
  orderNo         String                    @unique
  merchantId      String
  factoryId       String
  productId       String
  status          String                    @default("draft")
  currency        String                    @default("EUR")
  plannedQuantity Int
  plannedAmount   Decimal                   @default(0) @db.Decimal(14, 2)
  unitPrice       Decimal                   @default(0) @db.Decimal(12, 4)
  pickupDate      DateTime?
  dueDate         DateTime?
  notes           String?
  version         Int                       @default(0)
  createdBy       String?
  acceptedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  merchant        Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  factory         ProductionFactory         @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  items           ProductionOrderItem[]
  pickups         ProductionPickup[]
  deliveries      ProductionDelivery[]
  events          ProductionOrderEvent[]
  statementLines  ProductionStatementLine[]

  @@index([merchantId, status, dueDate])
  @@index([factoryId, status])
  @@index([productId])
}

model ProductionOrderItem {
  id                String                   @id @default(uuid())
  orderId           String
  variantId         String
  sku               String
  color             String?
  size              String?
  plannedQuantity   Int
  unitPrice         Decimal                  @default(0) @db.Decimal(12, 4)
  deliveredQuantity Int                      @default(0)
  acceptedQuantity  Int                      @default(0)
  rejectedQuantity  Int                      @default(0)
  reworkQuantity    Int                      @default(0)
  shortageQuantity  Int                      @default(0)
  order             ProductionOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  deliveryItems     ProductionDeliveryItem[]

  @@unique([orderId, variantId])
  @@index([orderId])
}

model ProductionPickup {
  id                  String            @id @default(uuid())
  pickupNo            String            @unique
  orderId             String
  merchantId          String
  factoryId           String
  pickupDate          DateTime
  pieces              Int
  packages            Int               @default(0)
  receivedPieces      Int?
  difference          Int               @default(0)
  note                String?
  status              String            @default("pending")
  merchantConfirmedAt DateTime?
  factoryConfirmedAt  DateTime?
  createdBy           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  order               ProductionOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factory             ProductionFactory @relation(fields: [factoryId], references: [id], onDelete: Restrict)

  @@index([orderId, pickupDate])
  @@index([factoryId, status])
}

model ProductionDelivery {
  id          String                        @id @default(uuid())
  deliveryNo  String                        @unique
  orderId     String
  merchantId  String
  factoryId   String
  status      String                        @default("submitted")
  note        String?
  submittedAt DateTime                      @default(now())
  inspectedAt DateTime?
  inspectedBy String?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  order       ProductionOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factory     ProductionFactory             @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  items       ProductionDeliveryItem[]
  inspections ProductionQualityInspection[]

  @@index([orderId, submittedAt])
  @@index([factoryId, status])
  @@index([merchantId, status])
}

model ProductionDeliveryItem {
  id               String               @id @default(uuid())
  deliveryId       String
  orderItemId      String
  declaredQuantity Int
  receivedQuantity Int                  @default(0)
  acceptedQuantity Int                  @default(0)
  rejectedQuantity Int                  @default(0)
  reworkQuantity   Int                  @default(0)
  shortageQuantity Int                  @default(0)
  statementId      String?
  delivery         ProductionDelivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem        ProductionOrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  statement        ProductionStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@unique([deliveryId, orderItemId])
  @@index([deliveryId])
  @@index([statementId])
}

model ProductionQualityInspection {
  id         String             @id @default(uuid())
  deliveryId String
  result     String
  inspector  String?
  notes      String?
  createdAt  DateTime           @default(now())
  delivery   ProductionDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

model ProductionOrderEvent {
  id         String          @id @default(uuid())
  orderId    String
  merchantId String
  type       String
  actorType  String
  actorId    String?
  fromStatus String?
  toStatus   String?
  payload    String?
  createdAt  DateTime        @default(now())
  order      ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([merchantId, createdAt])
}

model ProductionStatement {
  id                  String                          @id @default(uuid())
  statementNo         String                          @unique
  merchantId          String
  factoryId           String
  periodMonth         String                          @db.VarChar(7)
  version             Int                             @default(1)
  status              String                          @default("draft")
  currency            String                          @default("EUR")
  openingBalance      Decimal                         @default(0) @db.Decimal(14, 2)
  laborAmount         Decimal                         @default(0) @db.Decimal(14, 2)
  adjustmentAmount    Decimal                         @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal                         @default(0) @db.Decimal(14, 2)
  paidAmount          Decimal                         @default(0) @db.Decimal(14, 2)
  closingBalance      Decimal                         @default(0) @db.Decimal(14, 2)
  note                String?
  disputeReason       String?
  merchantConfirmedAt DateTime?
  factoryConfirmedAt  DateTime?
  confirmedAt         DateTime?
  createdBy           String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  merchant            Merchant                        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  factory             ProductionFactory               @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  lines               ProductionStatementLine[]
  adjustments         ProductionStatementAdjustment[]
  payments            ProductionPayment[]
  deliveryItems       ProductionDeliveryItem[]

  @@unique([factoryId, periodMonth, version])
  @@index([merchantId, status])
  @@index([factoryId, periodMonth])
}

model ProductionStatementLine {
  id          String              @id @default(uuid())
  statementId String
  orderId     String
  orderNo     String
  styleNo     String?
  productName String
  quantity    Int
  amount      Decimal             @db.Decimal(14, 2)
  breakdown   String?             @db.Text
  sortOrder   Int                 @default(0)
  statement   ProductionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  order       ProductionOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([statementId, sortOrder])
}

model ProductionStatementAdjustment {
  id            String              @id @default(uuid())
  statementId   String
  amount        Decimal             @db.Decimal(14, 2)
  reason        String
  createdBySide String
  createdBy     String?
  createdAt     DateTime            @default(now())
  statement     ProductionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
}

model ProductionPayment {
  id             String               @id @default(uuid())
  merchantId     String
  factoryId      String
  statementId    String?
  amount         Decimal              @db.Decimal(14, 2)
  currency       String               @default("EUR")
  method         String?
  reference      String?
  paidAt         DateTime
  recordedBy     String?
  proofUrl       String?
  note           String?
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  merchant       Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  factory        ProductionFactory    @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  statement      ProductionStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([merchantId, paidAt])
  @@index([factoryId, paidAt])
  @@index([statementId])
}

model ProductionMessage {
  id               String            @id @default(uuid())
  merchantId       String
  factoryId        String
  scopeType        String
  scopeId          String
  authorSide       String
  authorName       String
  body             String            @db.Text
  readByMerchantAt DateTime?
  readByFactoryAt  DateTime?
  createdAt        DateTime          @default(now())
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  factory          ProductionFactory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([scopeType, scopeId, createdAt])
  @@index([factoryId, scopeId])
  @@index([merchantId, createdAt])
}

/// Merchant-scoped business counterparty shared by customer links, suppliers and referrals.
model MerchantCounterparty {
  id                   String                 @id @default(uuid())
  merchantId           String
  companyName          String
  contactName          String?
  phone                String?
  email                String?
  country              String?
  city                 String?
  address              String?
  vatNumber            String?
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  merchant             Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantCustomerLink MerchantCustomerLink[]
  supplier             Supplier[]

  @@unique([id, merchantId])
  @@index([merchantId, companyName])
}

/// Trial referral program: one referred merchant can qualify once for a reward benefit.
model MerchantGrowthReferral {
  id                    String    @id @default(uuid())
  referrerMerchantId    String
  referredMerchantId    String    @unique
  referralCodeSnapshot  String    @db.VarChar(120)
  status                String    @default("pending") @db.VarChar(24)
  qualificationDeadline DateTime
  qualifiedAt           DateTime?
  rewardBenefitId       String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  referrer              Merchant  @relation("GrowthReferralReferrer", fields: [referrerMerchantId], references: [id], onDelete: Restrict)
  referred              Merchant  @relation("GrowthReferralReferred", fields: [referredMerchantId], references: [id], onDelete: Restrict)

  @@index([referrerMerchantId, status, createdAt])
  @@index([status, qualificationDeadline])
}

/// Promotion (PLUS months) granted by registration trial or merchant referral.
model MerchantPromotionBenefit {
  id               String                      @id @default(uuid())
  merchantId       String
  sourceMerchantId String?
  sourceType       String                      @db.VarChar(32)
  sourceId         String                      @db.VarChar(160)
  planId           String                      @default("PLUS") @db.VarChar(32)
  months           Int
  status           String                      @default("applied") @db.VarChar(24)
  subscriptionId   String?
  startsAt         DateTime
  endsAt           DateTime
  idempotencyKey   String                      @unique @db.VarChar(180)
  createdAt        DateTime                    @default(now())
  merchant         Merchant                    @relation("PromotionBenefitMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  sourceMerchant   Merchant?                   @relation("PromotionBenefitSourceMerchant", fields: [sourceMerchantId], references: [id], onDelete: SetNull)
  subscription     ModaGptBillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([merchantId, status, startsAt])
  @@index([sourceMerchantId, sourceType, createdAt], map: "MerchantPromotionBenefit_sourceMerchantId_sourceType_createdAt_")
  @@index([subscriptionId])
}
