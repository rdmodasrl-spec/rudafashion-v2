  width: 11rpx;
  height: 3rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
  background: var(--ink-quaternary);
  content: '';
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 30rpx;
}

.dashboard-scan {
  margin-left: var(--space-sm);
  padding: 12rpx 0 12rpx 12rpx;
  color: var(--ink-secondary);
