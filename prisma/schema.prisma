/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MerchantAiEmployeeInstallation {
  id                            String                          @id @default(uuid())
  merchantId                    String
  definitionId                  String
  status                        String                          @default("active") @db.VarChar(24)
  grantedPermissions            String                          @default("[]")
  installedBy                   String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  aiEmployeeCreativeDraft       AiEmployeeCreativeDraft[]
  aiEmployeeProductContentDraft AiEmployeeProductContentDraft[]
  aiEmployeeProductImportDraft  AiEmployeeProductImportDraft[]
  definition                    AiEmployeeDefinition            @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  merchant                      Merchant                        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, definitionId])
  @@index([definitionId, status])
  @@index([merchantId, status, createdAt])
}

model MerchantAiEmployeeMemory {
  id                 String    @id @default(uuid())
  merchantId         String
  category           String    @db.VarChar(24)
  content            String    @db.VarChar(500)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenantId           String
  scope              String    @default("MERCHANT") @db.VarChar(24)
  memoryType         String    @default("preference") @db.VarChar(32)
  status             String    @default("active") @db.VarChar(24)
  importance         Float     @default(0.5)
  confidence         Float     @default(0.5)
  source             String    @default("USER") @db.VarChar(24)
  sourceRef          String?   @db.VarChar(160)
  verificationStatus String    @default("unverified") @db.VarChar(24)
  version            Int       @default(1)
  expiresAt          DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  lastVerifiedAt     DateTime?
  lastAccessedAt     DateTime?
  accessCount        Int       @default(0)
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, category, updatedAt])
  @@index([tenantId, merchantId, scope, status, updatedAt])
}

model MerchantAiOrderDraft {
  id            String      @id @default(uuid())
  merchantId    String
  customerId    String
  createdBy     String
  request       String
  itemsJson     String
  leadTimeDays  Int
  deliveryTerms String
  paymentTerms  String
  status        String      @default("pending_review")
  reviewNote    String?
  salesQuoteId  String?     @unique
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer    @relation(fields: [customerId], references: [id])
  merchant      Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  salesQuote    SalesQuote? @relation(fields: [salesQuoteId], references: [id])

  @@index([customerId, createdAt])
  @@index([merchantId, status, createdAt])
}

model MerchantAiTeamAssignment {
  id            String   @id @default(uuid())
  merchantId    String
  agentId       String   @db.VarChar(48)
  industry      String   @db.VarChar(32)
  displayName   String   @db.VarChar(120)
  configuration String
  packVersion   String   @db.VarChar(32)
  status        String   @default("configured") @db.VarChar(24)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, agentId])
  @@index([merchantId, industry, status])
}

model MerchantAiTeamProvisionRun {
  id             String    @id @default(uuid())
  merchantId     String
  idempotencyKey String    @db.VarChar(160)
  industry       String    @db.VarChar(32)
  configHash     String    @db.VarChar(64)
  status         String    @default("started") @db.VarChar(24)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, status, createdAt])
}

model MerchantAssistantConversation {
  id         String                     @id @default(uuid())
  merchantId String
  actorId    String
  title      String                     @db.VarChar(120)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  merchant   Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages   MerchantAssistantMessage[]

  @@index([merchantId, actorId, updatedAt])
}

model MerchantAssistantMemory {
  id         String   @id @default(uuid())
  merchantId String
  actorId    String
  content    String   @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, actorId, updatedAt])
}

model MerchantAssistantMessage {
  id             String                        @id @default(uuid())
  conversationId String
  role           String
  content        String
  context        String                        @default("dashboard")
  metadata       String                        @default("{}")
  createdAt      DateTime                      @default(now())
  feedback       String?
  feedbackAt     DateTime?
  feedbackPrompt String?
  conversation   MerchantAssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([feedback, createdAt])
}

model MerchantBankAccount {
  id              String    @id @default(uuid())
  merchantId      String
  accountHolder   String
  ibanEncrypted   String
  ibanLast4       String
  status          String    @default("pending")
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([status, createdAt])
}

model MerchantCustomerLink {
  id             String                @id @default(uuid())
  merchantId     String
  customerId     String
  notes          String?
  tags           String                @default("[]")
  counterpartyId String?
  status         String                @default("active")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  counterparty   MerchantCounterparty? @relation(fields: [counterpartyId, merchantId], references: [id, merchantId], onDelete: Restrict)
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant       Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, customerId])
  @@unique([counterpartyId, merchantId])
  @@index([merchantId, updatedAt])
}

model MerchantEmployee {
  id                      String                    @id @default(uuid())
  merchantId              String
  email                   String
  name                    String
  passwordHash            String
  role                    String
  permissions             String                    @default("[]")
  active                  Boolean                   @default(true)
  lastLoginAt             DateTime?
  lastLoginIp             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  companyId               String?
  identityId              String?
