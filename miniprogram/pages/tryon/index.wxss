.tryon-page {
  padding-bottom: 48rpx;
}

.tryon-frames {
  display: flex;
  gap: 16rpx;
}

.tryon-frame {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  flex: 1;
  aspect-ratio: 3 / 4;
  border: 1rpx dashed #e5e5e5;
  border-radius: 10rpx;
  background: #f7f6f3;
}

.frame-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.frame-add {
  color: #525252;
  font-size: 56rpx;
  font-weight: 300;
}

.frame-label {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #1d1b19;
  font-size: 21rpx;
}

.tryon-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.category-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 180rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e5e0d9;
  border-radius: 8rpx;
  background: #fff;
  font-size: 23rpx;
}

.category-picker text {
  margin-left: 24rpx;
  color: #89847e;
}

.remaining-count {
  color: #89847e;
  font-size: 21rpx;
}

.consent-row {
  margin-top: 18rpx;
}

.consent-label {
  display: flex;
  align-items: center;
  color: #71695f;
  font-size: 21rpx;
}

.consent-label checkbox {
  transform: scale(0.8);
  transform-origin: left center;
}

.tryon-privacy-link {
  display: inline;
  margin-left: 8rpx;
  color: #756044;
  text-decoration: underline;
}

.result-frame {
  overflow: hidden;
  margin-top: 22rpx;
  border-radius: 10rpx;
  background: #f7f6f3;
}

.result-image {
  display: block;
  width: 100%;
}

.task-status,
.tryon-error {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
}

.task-status {
  color: #71695f;
}

.tryon-error {
  color: #a3342b;
}

.tryon-submit {
  margin-top: 22rpx;
}
