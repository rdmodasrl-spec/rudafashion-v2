.login-screen {
  min-height: 100vh;
  padding: 72rpx 30rpx 88rpx;
  background: linear-gradient(160deg, #f4f1eb 0%, #f8f8f7 42%, #eef0f1 100%);
}

.login-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  padding: 42rpx 36rpx 38rpx;
  border: 1rpx solid #e7e3dc;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 22rpx 60rpx rgba(37, 34, 29, .09), 0 2rpx 8rpx rgba(37, 34, 29, .035);
}

.login-heading {
  margin-bottom: 42rpx;
  text-align: left;
}

.login-brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 44rpx;
}

.brand-mark {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 16rpx;
  background: #171715;
  color: #d8c39d;
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 700;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-brand {
  display: block;
  color: #1d1b19;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.login-eyebrow {
  display: block;
  margin-top: 5rpx;
  color: #91836b;
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  margin-bottom: 10rpx;
  color: #1d1b19;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.login-form {
  display: flex;
  flex-direction: column;
}

.field-group {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin: 0 0 10rpx 2rpx;
  color: #4c4944;
  font-size: 22rpx;
  font-weight: 600;
}

.login-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 90rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #e4e0d9;
  border-radius: 13rpx;
  background: #fbfaf8;
  color: #25231f;
  font-size: 26rpx;
  line-height: 90rpx;
  transition: border-color 160ms ease, background-color 160ms ease;
}

.login-input:focus {
  border-color: #9c8965;
  background: #fff;
}

.login-input::placeholder {
  color: #aaa69f;
}

.password-field {
  position: relative;
  width: 100%;
}

.password-field .password-input {
  padding-right: 118rpx;
}

.password-toggle {
  position: absolute;
  top: 50%;
  display: flex;
  right: 18rpx;
  width: 76rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid #e4e0d9;
  color: #81765f;
  font-size: 21rpx;
  font-weight: 600;
  transform: translateY(-50%);
}

.login-links {
  display: flex;
  justify-content: flex-end;
  margin: -4rpx 2rpx 24rpx;
}

.login-privacy-note {
  margin: 0 2rpx 12rpx;
  color: #777168;
  font-size: 19rpx;
  line-height: 1.65;
}

.login-consent-group {
  margin-bottom: 22rpx;
}

.login-consent-row {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  color: #666;
  font-size: 20rpx;
}

.login-consent-row checkbox {
  flex: none;
  margin-right: 8rpx;
  transform: scale(.8);
  transform-origin: left center;
}

.login-consent-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.login-legal-link {
  margin-left: 6rpx;
  color: #4d402d;
  font-weight: 600;
  text-decoration: underline;
}

.reset-title {
  display: block;
  margin-bottom: 28rpx;
  color: #201e1b;
  font-size: 28rpx;
  font-weight: 700;
}

.reset-hint {
  margin: 8rpx 2rpx 12rpx;
  color: #777168;
  font-size: 21rpx;
  line-height: 1.5;
}

.forgot-password-link,
.registration-button {
  font-size: 22rpx;
}

.forgot-password-link {
  color: #78664a;
}

button.login-button {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 13rpx;
  background: linear-gradient(180deg, #292825 0%, #171715 100%);
  box-shadow: 0 8rpx 18rpx rgba(23, 23, 21, .16);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 92rpx;
}

button.login-button[disabled] {
  opacity: .62;
}

.error-box {
  background-color: #fff1f0;
  border: 2rpx solid #ffa39e;
  color: #cf1322;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 30rpx;
}

.choice-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #e8e5df;
  border-radius: 14rpx;
  background-color: #f8f7f4;
}

.item-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.item-meta {
  display: block;
  font-size: 24rpx;
  color: #8a8580;
}

.demo-account {
  margin-top: 40rpx;
  border: 2rpx dashed #dcd6d0;
  background-color: #fafafb;
}

.demo-account-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 0;
}

.text-button {
  background: none;
  border: none;
  color: #1d1b19;
  font-size: 24rpx;
  text-decoration: underline;
  padding: 0;
  margin: 0;
  line-height: 1.5;
  min-height: auto;
  width: auto !important;
}

.registration-button {
  align-self: center;
  margin-top: 30rpx;
  color: #78664a;
}

.demo-partner-link {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #eee;
}
