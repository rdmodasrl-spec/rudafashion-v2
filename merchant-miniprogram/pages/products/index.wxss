.product-list-screen {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.product-list-screen.has-batch-toolbar {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* 头部与操作 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.add-btn {
  height: 72rpx !important;
  min-height: 72rpx !important;
  padding: 0 var(--space-md) !important;
  font-size: 24rpx !important;
}

.icon-plus-small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex: 0 0 28rpx;
}

/* 搜索容器 */
.search-container {
  margin-bottom: var(--space-md);
}

.modern-search {
  height: 88rpx;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  padding: 0 var(--space-md);
  position: relative;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, .035), inset 0 1rpx 0 #fff, inset 0 0 0 1rpx #e7e7e7;
}

.search-icon-inner {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--space-sm);
  flex: 0 0 32rpx;
}

.search-input-field {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--ink-primary);
}

.search-clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  display: block;
  width: 24rpx;
  height: 24rpx;
}

.picker-chevron {
  display: inline-block;
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
  vertical-align: middle;
}

/* 快捷筛选 */
.filter-scroll-view {
  margin-bottom: var(--space-md);
  white-space: nowrap;
}

.filter-chips {
  display: flex;
  gap: var(--space-sm);
}

.filter-chip {
  padding: 12rpx 32rpx;
  background: var(--paper-tertiary);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-tertiary);
  transition: all 0.2s ease;
}

.filter-chip.active {
  background: var(--ink-primary);
  color: var(--paper-primary);
}

/* 工具栏 */
.toolbar-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.count-text {
  font-size: var(--font-size-xs);
  color: var(--ink-quaternary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.toolbar-actions {
  display: flex;
  gap: var(--space-md);
}

.tool-item {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-secondary);
  text-decoration: underline;
}

/* 高级筛选面板 */
.options-panel {
  background: var(--paper-secondary);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  border: var(--border-fine);
}

.options-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.picker-box {
  height: 72rpx;
  background: var(--paper-primary);
  border: var(--border-fine);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-sm);
  display: flex;
  align-items: center;
}

.picker-content {
  width: 100%;
  font-size: 20rpx;
  color: var(--ink-secondary);
  display: flex;
  justify-content: space-between;
}

.price-range {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.price-input {
  flex: 1;
  height: 72rpx;
  background: var(--paper-primary);
  border: var(--border-fine);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-sm);
  font-size: 20rpx;
}

.btn-sm {
  min-height: 64rpx !important;
  font-size: 20rpx !important;
}

/* 商品卡片 */
.product-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.product-item {
  display: flex;
  gap: var(--space-md);
  position: relative;
  padding: var(--space-sm) !important;
}

.item-visual {
  width: 160rpx;
  height: 200rpx;
  flex-shrink: 0;
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--paper-tertiary);
}

.item-img {
  width: 100%;
  height: 100%;
}

.item-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #f6f6f6, #ededed);
}

.item-img-placeholder .empty-state-icon {
  width: 52rpx;
  height: 52rpx;
}

.item-status-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
  color: var(--ink-primary);
  font-weight: 700;
  text-transform: uppercase;
}

.status-published { background: var(--ink-primary); color: #fff; }

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 4rpx;
}

.item-name {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--ink-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  flex: 1;
  padding-right: var(--space-sm);
}

.item-more-btn {
  display: flex;
  width: 52rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.more-action-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
}

.item-sku {
  font-size: 20rpx;
  color: var(--ink-quaternary);
  margin-bottom: auto;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: var(--space-sm);
}

.item-price-box {
  display: flex;
  align-items: baseline;
}

.item-currency {
  font-size: 20rpx;
  font-weight: 700;
  margin-right: 2rpx;
}

.item-price-val {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.item-stock {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--accent-success);
}

.item-stock.out { color: var(--accent-error); }

.item-specs {
  font-size: 18rpx;
  color: var(--ink-quaternary);
  margin-top: 4rpx;
}

/* 气泡菜单 */
.action-menu {
  position: absolute;
  top: 60rpx;
  right: var(--space-md);
  background: var(--paper-primary);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-floating);
  z-index: 50;
  width: 240rpx;
  overflow: hidden;
  border: var(--border-fine);
}

.menu-item {
  padding: 24rpx 32rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-bottom: var(--border-fine);
}

.menu-item:last-child { border-bottom: none; }
.menu-item.danger { color: var(--accent-error); }

/* 批量操作 */
.batch-bar {
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: var(--space-lg);
  right: var(--space-lg);
  background: var(--ink-primary);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  z-index: 100;
  box-shadow: var(--shadow-floating);
}

.batch-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.batch-count { color: #fff; font-size: 20rpx; font-weight: 600; }
.batch-clear { color: rgba(255,255,255,0.6); font-size: 20rpx; text-decoration: underline; }

.batch-btns {
  display: flex;
  gap: var(--space-sm);
}

.flex-1 { flex: 1; }

/* 模态框 */
.full-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--paper-primary);
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.modal-header {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--space-lg);
  border-bottom: var(--border-fine);
}

.modal-close { display: flex; align-items: center; width: 64rpx; }
.modal-close-icon { display: block; width: 32rpx; height: 32rpx; }
.modal-title { flex: 1; text-align: center; font-weight: 700; font-size: 32rpx; }
.modal-spacer { width: 64rpx; }

.modal-content { flex: 1; padding: var(--space-lg); }

.category-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: var(--border-fine);
}

.cat-name { display: block; font-size: var(--font-size-md); font-weight: 700; }
.cat-count { font-size: 20rpx; color: var(--ink-quaternary); }

.cat-actions { display: flex; gap: var(--space-md); }
.cat-btn { font-size: 22rpx; font-weight: 700; text-decoration: underline; }
.cat-btn.danger { color: var(--accent-error); }

.product-list-screen {
  padding: 8rpx 32rpx calc(124rpx + env(safe-area-inset-bottom));
  background: var(--surface-page);
}

.product-summary-card {
  margin-bottom: 14rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  color: #1d1b19;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, .035), inset 0 1rpx 0 #fff;
}

.mobile-summary-heading {
  color: #4d4d4d;
