.product-form-screen {
  padding: 0 28rpx calc(156rpx + env(safe-area-inset-bottom));
  background: var(--surface-page);
}

.product-form-heading {
  margin-top: 80rpx;
  text-align: center;
}

.product-form-title {
  display: block;
  color: #1d1b19;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.mode-switch {
  display: flex;
  width: 94%;
  box-sizing: border-box;
  gap: 8rpx;
  margin-top: 20rpx;
  margin-right: auto;
  margin-left: auto;
  padding: 4rpx;
  border: 1rpx solid #e9e9e9;
  border-radius: 16rpx;
  background: #efefef;
}

.mode-button {
  flex: 1;
  min-height: 35rpx;
  margin: 0;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  background: transparent;
  color: #777;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 33rpx;
  transition: background-color var(--motion-fast), color var(--motion-fast), box-shadow var(--motion-fast), transform var(--motion-fast);
}

.mode-button.mode-selected {
  border-color: #111;
  background: linear-gradient(180deg, #303030 0%, #171717 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 3rpx 7rpx rgba(0, 0, 0, .14), inset 0 1rpx 0 rgba(255, 255, 255, .14);
}

.mode-button:active,
.form-card .form-button:active,
.media-order button:active {
  transform: scale(.98);
  opacity: .82;
}

.form-actions {
  position: sticky;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  z-index: 5;
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 0;
  background: transparent;
}

.form-actions .save-button {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 17rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
  transition: background-color var(--motion-fast), transform var(--motion-fast), box-shadow var(--motion-fast), border-color var(--motion-fast);
}

.form-actions .primary-button {
  border: 1rpx solid #111;
  background: linear-gradient(180deg, #303030 0%, #171717 100%);
  color: #fff;
  box-shadow: 0 5rpx 12rpx rgba(0, 0, 0, .2), inset 0 1rpx 0 rgba(255, 255, 255, .2), inset 0 -1rpx 0 rgba(0, 0, 0, .28);
}

.form-actions .secondary-button {
  border: 1rpx solid #e2e2e2;
  background: linear-gradient(180deg, #fff 0%, #f7f7f7 100%);
  color: #4d4d4d;
  box-shadow: 0 4rpx 9rpx rgba(0, 0, 0, .09), inset 0 1rpx 0 #fff, inset 0 -1rpx 0 rgba(0, 0, 0, .035);
}

.form-actions .save-button:active {
  transform: translateY(2rpx) scale(.985);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, .12);
}

.form-actions .save-button[disabled] {
  opacity: .58;
}

.form-actions .save-button[loading] {
  opacity: .82;
}

.form-card .form-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 56rpx;
  margin: 8rpx 8rpx 0 0;
  padding: 0 14rpx;
  border: 1rpx solid #e7e5e1;
  border-radius: 13rpx;
  background: linear-gradient(180deg, #fff 0%, #f8f7f5 100%);
  color: #555;
  font-size: 19rpx;
  box-shadow: 0 2rpx 5rpx rgba(28, 25, 20, .045), inset 0 1rpx 0 #fff;
}

.product-form-screen .item-meta {
  display: block;
  color: #858585;
  font-size: 20rpx;
  line-height: 1.45;
}

.option-group {
  margin: 14rpx 0 18rpx;
  padding: 16rpx;
  border: 1rpx solid #ebe9e5;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #fcfcfb 0%, #f8f7f5 100%);
}

.color-options {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  justify-items: center;
  gap: 12rpx 6rpx;
}

.more-colors-toggle,
.other-size-toggle {
  position: relative;
  display: flex;
  width: 44rpx;
  height: 44rpx;
  min-height: 44rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e7e5e1;
  border-radius: 50%;
  background: linear-gradient(145deg, #fff 0%, #f7f6f3 100%);
  box-shadow: 0 2rpx 5rpx rgba(28, 25, 20, .055), inset 0 1rpx 0 #fff;
  transition: background-color var(--motion-fast), transform var(--motion-fast), border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.more-colors-toggle-selected,
.other-size-toggle-selected {
  border-color: #bdbdbd;
}

.more-colors-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: .72;
  transition: transform var(--motion-fast), opacity var(--motion-fast);
}

.more-colors-toggle-open .more-colors-icon,
.other-size-toggle-open .more-colors-icon {
  transform: rotate(45deg);
  opacity: 1;
}

.more-colors-selected-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  background: #1d1b19;
}

.more-colors-panel,
.more-sizes-panel {
  padding-top: 8rpx;
}

.color-options-additional {
  grid-template-columns: repeat(8, minmax(0, 1fr));
  margin-top: 0;
}

.color-option-chip {
  position: relative;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 50%;
  background: transparent;
  transition: transform var(--motion-fast), box-shadow var(--motion-fast), border-color var(--motion-fast);
}

.custom-color-chip {
  width: 68rpx;
  height: 82rpx;
  flex-direction: column;
  gap: 4rpx;
  border-radius: 16rpx;
}

.custom-color-chip .color-option-swatch {
  width: 36rpx;
  height: 36rpx;
  flex-basis: 36rpx;
}

.custom-color-label {
  display: block;
  max-width: 62rpx;
  overflow: hidden;
  color: #555;
  font-size: 16rpx;
  line-height: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.color-option-swatch {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(0, 0, 0, .1);
  border-radius: 50%;
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, .1), 0 2rpx 4rpx rgba(0, 0, 0, .055);
}

.color-option-chip-selected {
  border-color: #242321;
  box-shadow: 0 0 0 3rpx #fff inset, 0 0 0 1rpx #242321, 0 2rpx 5rpx rgba(0, 0, 0, .1);
  transform: scale(.94);
}

.color-option-chip:active,
.size-option-chip:active,
.more-colors-toggle:active,
.other-size-toggle:active {
  transform: scale(.94);
}

.color-selected-mark {
  position: absolute;
  right: 1rpx;
  bottom: 1rpx;
  display: flex;
  width: 21rpx;
  height: 21rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background: #1d1b19;
  color: #fff;
  font-size: 15rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, .2);
}

.size-options {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  justify-items: center;
  gap: 10rpx 6rpx;
}

.size-option-chip {
  position: relative;
  display: flex;
  min-width: 0;
  width: 58rpx;
  min-height: 48rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 6rpx 2rpx;
  border: 1rpx solid #e5e3df;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #fff 0%, #faf9f7 100%);
  color: #505050;
  font-size: 17rpx;
  white-space: nowrap;
  font-weight: 500;
  transition: transform var(--motion-fast), background-color var(--motion-fast), color var(--motion-fast), border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.size-option-chip-selected {
  border-color: #1d1b19;
  background: linear-gradient(180deg, #303030 0%, #171717 100%);
  color: #fff;
  box-shadow: 0 3rpx 7rpx rgba(0, 0, 0, .14), inset 0 1rpx 0 rgba(255, 255, 255, .14);
}

.size-option-check { display: none; }

.size-options-additional {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  justify-items: stretch;
  gap: 10rpx;
}

.size-options-additional .size-option-chip {
  width: auto;
  min-height: 56rpx;
  padding: 8rpx 6rpx;
  font-size: 19rpx;
}

.custom-color-entry {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.custom-color-input {
  min-width: 0;
  height: 58rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 1rpx solid #e7e7e7;
  border-radius: 12rpx;
  background: #fff;
  color: #252525;
  font-size: 20rpx;
}

.custom-color-add {
  display: flex;
  width: 80rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e2e2e2;
  border-radius: 12rpx;
  background: #fff;
  color: #333;
  font-size: 19rpx;
  line-height: 1;
}

.custom-color-add::after {
  border: 0;
}

.form-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #e7e5e1;
  border-radius: 26rpx;
  background: linear-gradient(155deg, #fff 0%, #fdfdfc 100%);
  box-shadow: 0 7rpx 22rpx rgba(31, 28, 23, .04), inset 0 1rpx 0 #fff;
}

.product-form-screen .input {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  margin-bottom: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e7e5e1;
  border-radius: 17rpx;
  background: linear-gradient(180deg, #fbfbfa 0%, #f7f6f4 100%);
  color: #242424;
  font-size: 24rpx;
  box-shadow: inset 0 1rpx 2rpx rgba(25, 23, 20, .025), 0 1rpx 0 rgba(255, 255, 255, .8);
  transition: background-color var(--motion-fast), border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.product-form-screen .input:focus,
.product-form-screen .textarea:focus {
  border-color: #8b8985;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(29, 27, 25, .055), 0 2rpx 7rpx rgba(29, 27, 25, .035);
}

.product-form-screen .form-input-primary {
  min-height: 94rpx;
  border-color: #dadada;
  background: #fff;
  font-size: 27rpx;
  font-weight: 600;
}

.product-form-screen .form-price-input {
  border-color: #dedbd5;
  background: linear-gradient(180deg, #fff 0%, #fcfbf9 100%);
  font-weight: 600;
}

.product-form-screen .input:last-child { margin-bottom: 0; }
.product-form-screen .input::placeholder,
.product-form-screen .textarea::placeholder { color: #aaa; }

.picker-input {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #404040;
}

.picker-field-label {
  flex: 0 0 auto;
  color: #888;
  font-size: 21rpx;
}

.picker-field-value {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #303030;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-chevron {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
  opacity: .55;
  transform: rotate(0deg);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.price-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.price-pair .input {
  min-width: 0;
  margin-bottom: 0;
  padding-right: 14rpx;
  padding-left: 14rpx;
}

.form-grid .input { margin-bottom: 0; }

.variant-card {
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #e6e6e6;
  border-radius: 20rpx;
  background: #f8f8f8;
}

.archive-action {
  min-height: 44rpx;
  margin: 0 0 12rpx auto;
  padding: 0 12rpx;
  border: 1rpx solid #ebebeb;
  border-radius: 12rpx;
  background: #fff;
  color: #777;
  font-size: 19rpx;
  line-height: 42rpx;
}

.variant-stock-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e9e9e9;
  border-radius: 15rpx;
  background: #fff;
}

.stock-input { flex: 1; }
.cost-field { margin-top: 12rpx; }
.lifecycle-heading { margin-top: 20rpx; }
.lifecycle-options { display: flex; flex-wrap: wrap; gap: 20rpx; }

.preference-row {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e9e9e9;
  border-radius: 17rpx;
  background: #fafafa;
  color: #424242;
  font-size: 22rpx;
}

.preference-row switch { transform: scale(.92); transform-origin: right center; }
.lifecycle-option { display: flex; min-height: 48rpx; align-items: center; gap: 8rpx; color: #404040; font-size: 22rpx; }

.product-form-screen .textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e9e9e9;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  color: #242424;
  font-size: 24rpx;
  line-height: 1.5;
}

.character-count { display: block; margin-top: 8rpx; color: #8a8a8a; font-size: 19rpx; text-align: right; }

.media-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.media-item {
  position: relative;
  min-width: 0;
  height: 220rpx;
  overflow: hidden;
  border: 1rpx solid #e5e3df;
  border-radius: 16rpx;
  background: #f4f3f1;
  box-shadow: 0 4rpx 11rpx rgba(29, 27, 25, .075), inset 0 1rpx 0 rgba(255, 255, 255, .75);
}

.media-item-main {
  grid-column: span 2;
  height: 300rpx;
}

.media-preview { width: 100%; height: 100%; }

.product-zone-title {
  display: block;
  margin-bottom: 16rpx;
  color: #444;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.product-zone-picker {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 2rpx solid #d9d7d2;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fcfcfb 0%, #f7f6f4 100%);
  box-shadow: 0 3rpx 8rpx rgba(29, 27, 25, .035), inset 0 1rpx 0 #fff;
  transition: background-color var(--motion-fast), transform var(--motion-fast), border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.product-zone-value {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #3b3b3b;
  font-size: 34rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-zone-chevron {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  opacity: .65;
}

.media-role {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  z-index: 1;
  padding: 6rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, .24);
  border-radius: 999rpx;
  background: rgba(20, 20, 20, .72);
  color: #fff;
  font-size: 17rpx;
}

.media-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .24);
  border-radius: 50%;
  background: rgba(20, 20, 20, .72);
  color: #fff;
  font-size: 28rpx;
  line-height: 42rpx;
}

.media-order {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  padding: 5rpx;
  border: 1rpx solid rgba(255, 255, 255, .15);
  border-radius: 13rpx;
  background: rgba(18, 18, 18, .58);
}

.media-order button {
  width: auto;
  min-height: 42rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 9rpx;
  background: rgba(255, 255, 255, .12);
  color: #fff;
  font-size: 17rpx;
  line-height: 40rpx;
}

.media-order button[disabled] { opacity: .4; }

.media-upload-progress {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(18, 18, 18, .62);
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
}

.media-upload-spinner {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid rgba(255, 255, 255, .35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: media-upload-spin .8s linear infinite;
}

@keyframes media-upload-spin {
  to { transform: rotate(360deg); }
}

.image-select {
  display: flex;
  min-width: 0;
  height: 220rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx dashed #c8c8c8;
  border-radius: 19rpx;
  background: linear-gradient(145deg, #fbfbfb, #f2f2f2);
  color: #686868;
  font-size: 19rpx;
  text-align: center;
  transition: background-color var(--motion-fast), border-color var(--motion-fast), transform var(--motion-fast);
}

.image-select-empty {
  grid-column: span 3;
  height: 460rpx;
  border-radius: 22rpx;
  border-width: 4rpx;
  border-color: #d5d3ce;
  background: linear-gradient(145deg, #fcfcfb 0%, #f7f6f4 100%);
  box-shadow: inset 0 1rpx 0 #fff, 0 2rpx 8rpx rgba(29, 27, 25, .025);
}

.image-select-empty .image-plus-icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 18rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  opacity: .62;
}

.image-select-title {
  color: #666;
  font-size: 24rpx;
  font-weight: 600;
}

.image-select-hint {
  margin-top: 12rpx;
  color: #999;
  font-size: 20rpx;
}

.image-plus-icon {
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .05);
}

.image-select:active { background: #eee; transform: scale(.98); }
.preview-image { width: 100%; height: 100%; }

.image-select text {
  max-width: 100%;
  padding: 0 8rpx;
  line-height: 1.4;
}

.image-select-empty text {
  padding: 0 16rpx;
}

.error-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f1d6d6;
  border-radius: 16rpx;
  background: #fff8f8;
  color: #a4262c;
  font-size: 22rpx;
  line-height: 1.5;
}

.save-button {
  margin-top: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, .12);
}

@media (max-width: 360px) {
  .product-form-screen { padding-right: 20rpx; padding-left: 20rpx; }
  .form-card { padding: 20rpx; }
  .option-group { padding: 13rpx; }
  .color-options { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .color-options-additional { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .size-options { gap: 8rpx; }
  .size-option-chip { font-size: 19rpx; }
  .size-options-additional { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .form-grid { grid-template-columns: minmax(0, 1fr); }
  .price-pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .media-grid { gap: 8rpx; }
}

.product-form-screen {
  color: #242321;
  -webkit-font-smoothing: antialiased;
}

.form-card {
  border-color: #e5e2dc;
  background: linear-gradient(145deg, #fff 0%, #fcfbf9 100%);
  box-shadow: 0 10rpx 28rpx rgba(35, 31, 25, .065), 0 2rpx 6rpx rgba(35, 31, 25, .025), inset 0 1rpx 0 #fff;
  transition: border-color var(--motion-fast), box-shadow var(--motion-fast);
}

.product-form-screen .input,
.product-form-screen .textarea,
.custom-color-input {
  border-color: #e2dfd9;
  color: #242321;
}

.product-form-screen .input::placeholder,
.product-form-screen .textarea::placeholder,
.custom-color-input::placeholder {
  color: #89857e;
}

.product-form-screen .input:focus,
.product-form-screen .textarea:focus,
.custom-color-input:focus {
  border-color: #9a9387;
  box-shadow: 0 0 0 4rpx rgba(96, 82, 59, .09), 0 5rpx 14rpx rgba(35, 31, 25, .055);
}

.product-form-screen .item-meta,
.character-count {
  color: #716d66;
}

.variant-card {
  border-color: #e2dfd9;
  background: linear-gradient(145deg, #faf9f7 0%, #f5f3ef 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .9), 0 3rpx 9rpx rgba(35, 31, 25, .035);
  transition: border-color var(--motion-fast), box-shadow var(--motion-fast), transform var(--motion-fast);
}

.variant-card:active,
.media-item:active,
.image-select:active,
.product-zone-picker:active {
  transform: translateY(2rpx) scale(.99);
}

.media-item {
  border-color: #dedbd5;
  box-shadow: 0 7rpx 18rpx rgba(35, 31, 25, .1), inset 0 1rpx 0 rgba(255, 255, 255, .8);
  transition: transform var(--motion-fast), box-shadow var(--motion-fast), border-color var(--motion-fast);
}

.image-select {
  border-color: #c9c4ba;
  background: linear-gradient(145deg, #fff 0%, #f4f2ee 100%);
  color: #4e4a43;
  box-shadow: inset 0 1rpx 0 #fff, 0 4rpx 12rpx rgba(35, 31, 25, .045);
}

.image-select-title {
  color: #35322e;
  font-weight: 600;
}

.image-select-hint {
  color: #77726a;
}

.form-actions .primary-button {
  background: linear-gradient(180deg, #3b3935 0%, #1d1b19 100%);
  box-shadow: 0 8rpx 18rpx rgba(29, 27, 25, .2), inset 0 1rpx 0 rgba(255, 255, 255, .2), inset 0 -1rpx 0 rgba(0, 0, 0, .3);
}

.form-actions .secondary-button,
.form-card .form-button,
.custom-color-add,
.archive-action {
  border-color: #dedbd5;
  background: linear-gradient(180deg, #fff 0%, #f6f4f0 100%);
  color: #3f3c37;
  box-shadow: 0 4rpx 10rpx rgba(35, 31, 25, .065), inset 0 1rpx 0 #fff;
  transition: transform var(--motion-fast), box-shadow var(--motion-fast), background-color var(--motion-fast);
}

.form-card .form-button:active,
.custom-color-add:active,
.archive-action:active {
  transform: translateY(2rpx) scale(.985);
  box-shadow: inset 0 2rpx 5rpx rgba(35, 31, 25, .11);
}

.industry-attribute-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.industry-attribute-title {
  font-size: var(--font-size-xs);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--ink-tertiary);
  text-transform: uppercase;
}

.industry-field-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md) 0;
  border-bottom: var(--border-fine);
}

.industry-field-label {
  flex: 0 0 auto;
  font-size: var(--font-size-sm);
  color: var(--ink-secondary);
}

.industry-field-value {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--ink-primary);
  text-align: right;
}

.industry-field-chevron {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.36;
}

