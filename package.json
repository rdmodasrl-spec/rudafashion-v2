{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:apps && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:apps": "tsx scripts/build-app.ts all",
    "build:app:frontend-web": "tsx scripts/build-app.ts frontend-web",
    "build:app:frontend-mobile": "tsx scripts/build-app.ts frontend-mobile",
    "build:app:merchant-admin-web": "tsx scripts/build-app.ts merchant-admin-web",
    "build:app:merchant-admin-mobile": "tsx scripts/build-app.ts merchant-admin-mobile",
    "build:app:platform-admin-web": "tsx scripts/build-app.ts platform-admin-web",
    "build:app:platform-admin-mobile": "tsx scripts/build-app.ts platform-admin-mobile",
    "publish:app": "tsx scripts/publish-app.ts",
    "rollback:app": "tsx scripts/rollback-app.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "mobile:run:ios": "npm run mobile:sync && cap run ios",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:app-store:integration": "bash scripts/test-ai-growth-p0-isolated.sh app-store",
    "test:production-chain:integration": "bash scripts/test-ai-growth-p0-isolated.sh production-chain",
    "test:billing:integration": "bash scripts/test-ai-growth-p0-isolated.sh billing",
    "test:modagpt:integration": "bash scripts/test-ai-growth-p0-isolated.sh modagpt",
    "test:modagpt:brain:integration": "bash scripts/test-ai-growth-p0-isolated.sh modagpt-brain",
    "test:p0:integration": "bash scripts/test-ai-growth-p0-isolated.sh p0",
    "test:e2e": "bash scripts/test-pos-e2e-isolated.sh",
    "test:e2e:seed": "bash scripts/test-pos-e2e-isolated.sh --seed-only",
    "smoke:post-deploy": "tsx scripts/post-deploy-smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:backup:predeploy": "tsx scripts/predeploy-backup.ts",
    "db:recovery:drill": "tsx scripts/recovery-drill.ts",
    "db:import-fashion-community": "tsx scripts/migrate-fashion-community.ts",
    "db:seed": "prisma db seed",
    "db:seed-demo-zones": "tsx scripts/seed-demo-zones.ts",
    "db:seed-industry-demo": "tsx scripts/seed-industry-demo-merchants.ts",
    "db:seed-clearance-demo": "tsx scripts/seed-clearance-demo.ts",
    "db:seed-home-sections-demo": "tsx scripts/seed-home-sections-demo.ts",
    "db:clear-business-data": "tsx scripts/clear-business-data.ts",
    "start:production": "bash scripts/start-production.sh",
    "pm2:logs": "pm2 logs ruda-fashion",
    "test:e2e:industry": "bash scripts/test-industry-e2e-isolated.sh",
    "test:consumer:integration": "bash scripts/test-consumer-account-isolated.sh"
  },
