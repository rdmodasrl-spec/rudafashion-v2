page {
  background-color: #f5f5f7;
  color: #1d1b19;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --radius-full: 999rpx;
  --radius-control: 10rpx;
  --paper-primary: #ffffff;
  --paper-secondary: #faf9f7;
  --paper-tertiary: #f5f5f7;
  --ink-primary: #1d1b19;
  --ink: #1d1b19;
  --ink-secondary: #4a4641;
  --ink-tertiary: #6e6963;
  --ink-quaternary: #8a8580;
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 40rpx;
  --border-fine: 1rpx solid #e7e4df;
  --accent-error: #cf1322;
  --accent-success: #389e0d;
  --shadow-floating: 0 12rpx 36rpx rgba(29, 27, 25, .16);
  --shadow-soft: 0 4rpx 20rpx rgba(0, 0, 0, .06);
  --shadow-subtle: 0 2rpx 10rpx rgba(0, 0, 0, .04);
  --surface-page: #f7f7f7;
  --surface-card: #ffffff;
  --surface-muted: #f3f3f3;
  --line-subtle: #ebebeb;
  --ink-muted: #777777;
  --motion-fast: 140ms ease;
}

button::after { border: 0; }

.screen {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 3rpx 12rpx rgba(22, 22, 22, .045), inset 0 1rpx 0 rgba(255, 255, 255, .96), inset 0 0 0 1rpx #e9e9e9;
}

.ruda-card {
  padding: var(--space-md);
  border: 1rpx solid var(--line-subtle);
  border-radius: 24rpx;
  background: var(--paper-primary);
  box-shadow: 0 3rpx 12rpx rgba(22, 22, 22, .045), inset 0 1rpx 0 rgba(255, 255, 255, .96);
  transition: opacity var(--motion-fast), transform var(--motion-fast), box-shadow var(--motion-fast);
}

.ruda-card--elevated { box-shadow: 0 8rpx 24rpx rgba(22, 22, 22, .075), inset 0 1rpx 0 rgba(255, 255, 255, .98); }
.ruda-card--pressed,
.btn--pressed {
  transform: translateY(2rpx);
  opacity: .84;
}

.ui-card {
  box-sizing: border-box;
  border: 1rpx solid #e8e8e8;
  border-radius: 24rpx;
  background: var(--surface-card);
  box-shadow: 0 3rpx 12rpx rgba(22, 22, 22, .045), inset 0 1rpx 0 rgba(255, 255, 255, .98);
  transition: transform var(--motion-fast), box-shadow var(--motion-fast), border-color var(--motion-fast);
}

.ui-list-row {
  transition: background-color var(--motion-fast), opacity var(--motion-fast);
}

.ui-row-pressed {
  background: linear-gradient(180deg, #f8f8f8, #f1f1f1);
  opacity: .92;
}

.ui-button {
  box-sizing: border-box;
  min-height: 88rpx;
  border: 1rpx solid rgba(0, 0, 0, .08);
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: opacity var(--motion-fast), transform var(--motion-fast), background-color var(--motion-fast), box-shadow var(--motion-fast);
}

button.ui-button--primary {
  border-color: #111;
  background: linear-gradient(180deg, #343434 0%, #191919 55%, #111 100%);
  color: #fff;
  box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, .16), inset 0 1rpx 0 rgba(255, 255, 255, .16);
}

button.ui-button--secondary {
  border-color: #e4e4e4;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .035), inset 0 1rpx 0 #fff;
}

.ui-button--quiet {
  background: transparent;
  color: var(--ink-secondary);
}

.ui-button-pressed,
.ui-button:active {
  transform: translateY(2rpx) scale(.985);
  opacity: .82;
  box-shadow: inset 0 2rpx 5rpx rgba(0, 0, 0, .1);
}

button.ui-button[disabled] {
  opacity: .42;
}

.ui-chip {
  border-radius: 999rpx;
  transition: opacity var(--motion-fast), background-color var(--motion-fast), color var(--motion-fast), transform var(--motion-fast), box-shadow var(--motion-fast);
}

.ui-status {
  box-sizing: border-box;
  border: 1rpx solid var(--line-subtle);
  border-radius: 20rpx;
  background: #fff;
  color: var(--ink-secondary);
}

.h1, .h2, .h3 {
  display: block;
  color: var(--ink-primary);
  font-weight: 700;
}

.h1 { font-size: 44rpx; }
.h2 { font-size: 36rpx; }
.h3 { font-size: 30rpx; }
.caption { color: var(--ink-quaternary); font-size: var(--font-size-xs); line-height: 1.5; }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 0 var(--space-md);
  border: 1rpx solid rgba(0, 0, 0, .08);
  border-radius: 24rpx;
  font-size: var(--font-size-sm);
  font-weight: 600;
  line-height: 1.4;
  transition: opacity var(--motion-fast), transform var(--motion-fast), background-color var(--motion-fast), box-shadow var(--motion-fast);
}

button.btn--primary {
  border-color: #111;
  background: linear-gradient(180deg, #343434 0%, #191919 55%, #111 100%);
  color: #fff;
  box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, .16), inset 0 1rpx 0 rgba(255, 255, 255, .16);
}
button.btn--secondary {
  border-color: #e4e4e4;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  color: var(--ink-primary);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .035), inset 0 1rpx 0 #fff;
}
button.btn--ghost { background: transparent; color: var(--ink-secondary); }
.btn-sm { min-height: 72rpx; padding: 0 var(--space-sm); font-size: var(--font-size-xs); }

button.btn[disabled] {
  opacity: .44;
}

button.btn:active {
  transform: translateY(2rpx) scale(.985);
  opacity: .84;
  box-shadow: inset 0 2rpx 5rpx rgba(0, 0, 0, .1);
}

.ruda-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 var(--space-md);
  border: var(--border-fine);
  border-radius: 20rpx;
  background: var(--paper-primary);
  color: var(--ink-primary);
  font-size: var(--font-size-sm);
}

.placeholder { color: #aaa49d; }

.badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  line-height: 1.35;
}

.badge--neutral { background: #f0eeeb; color: var(--ink-secondary); }
.status-pending { background: #fff4e5; color: #9a5b00; }
.status-confirmed, .status-picking { background: #eaf3ff; color: #245b9e; }
.status-shipped { background: #e9f6ed; color: #26733c; }
.status-delivered { background: #edf6e8; color: #3d6b28; }

.divider { height: 1rpx; margin: var(--space-md) 0; background: #e7e4df; }

.empty-view {
  display: flex;
  min-height: 240rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--space-md);
  color: var(--ink-quaternary);
  text-align: center;
}

.empty-icon { margin-bottom: var(--space-sm); color: #b6b0a8; font-size: var(--font-size-xs); letter-spacing: 2rpx; }
.empty-state-icon { display: block; width: 68rpx; height: 68rpx; opacity: .76; }
.empty-text { color: var(--ink-secondary); font-size: var(--font-size-sm); }

.status-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md);
  color: var(--ink-quaternary);
  font-size: var(--font-size-xs);
}

.status-notice.error { color: var(--accent-error); }
.status-notice.warning { color: #9a5b00; }
.retry-btn { margin-left: var(--space-sm); color: var(--ink-primary); font-weight: 600; text-decoration: underline; }

.skeleton {
  border-radius: var(--radius-xs);
  background: linear-gradient(90deg, #f0eeeb 25%, #f7f6f4 50%, #f0eeeb 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  to { background-position: -200% 0; }
}

.primary-button {
  background-color: #1d1b19;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

button.primary-button[disabled] {
  color: #ffffff;
  opacity: .56;
}

.secondary-button {
  background-color: #ffffff;
  color: #1d1b19;
  border: 2rpx solid #1d1b19;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.input {
  background-color: #f5f5f7;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.animate-fade-in {
  animation: ruda-enter 180ms ease-out both;
}

@keyframes ruda-enter {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.mobile-summary-card {
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(155deg, #303030 0%, #1d1d1d 52%, #111 100%);
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, .17), inset 0 1rpx 0 rgba(255, 255, 255, .14);
}

.mobile-summary-heading {
  display: block;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.mobile-summary-grid {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .16);
}

.mobile-summary-stat {
  min-width: 0;
  flex: 1;
  padding: 0 16rpx;
  border-left: 1rpx solid rgba(255, 255, 255, .16);
}

.mobile-summary-stat:first-child {
  padding-left: 0;
  border-left: 0;
}

.mobile-summary-label,
.mobile-summary-value {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mobile-summary-label {
  color: rgba(255, 255, 255, .58);
  font-size: 20rpx;
}

.mobile-summary-value {
  margin-top: 8rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.mobile-summary-skeleton {
  box-sizing: border-box;
  min-height: 230rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #1d1b19;
}

.mobile-summary-skeleton-line,
.mobile-summary-skeleton-grid {
  border-radius: 8rpx;
  background: rgba(255, 255, 255, .12);
}

.mobile-summary-skeleton-line {
  width: 34%;
  height: 22rpx;
}

.mobile-summary-skeleton-grid {
  height: 80rpx;
  margin-top: 54rpx;
}
