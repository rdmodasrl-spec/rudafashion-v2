# Local Ollama API used by the on-premises Qwen merchant support assistant.
# The application only accepts a loopback URL; never expose Ollama on a public interface.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Enables the ModaGPT Brain retrieval, feedback integration and PostgreSQL
# event worker. Keep false until Brain and task-queue migrations are deployed.
MODAGPT_BRAIN_ENABLED="false"

# APP_URL: The merchant/API host used for server-side callbacks.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://ruda.fashion"
# Every browser origin used by Google sign-in must also be registered in the
# Google Cloud OAuth client. For local testing add http://localhost:3000 there.
GOOGLE_ALLOWED_ORIGINS="https://modaui.com,https://www.modaui.com,https://ruda.fashion,https://www.ruda.fashion,https://b2b.ruda.fashion,https://shop.ruda.fashion,https://product.ruda.fashion,https://stock.ruda.fashion,https://ai.ruda.fashion,https://order.ruda.fashion,https://admin.ruda.fashion,https://a.ruda.fashion,http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL connection used by Prisma and the Express API.
# Enable only after applying the schema and importing/verifying the legacy JSON data.
# FASHION_COMMUNITY_STORAGE=database
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/xversal?schema=public"

# Required in production. Generate long random values; never use demo defaults.
JWT_BUYER_SECRET="replace-with-a-long-random-secret"
JWT_MERCHANT_SECRET="replace-with-a-long-random-secret"
JWT_ADMIN_SECRET="replace-with-a-long-random-secret"

# Administrator API access control (production only).
# ADMIN_IP_WHITELIST: public operator IPs allowed to call /api/admin*. Empty list is fail-closed,
# so an unset value rejects every admin request from a public IP. Comma separated, CIDR supported;
# IPv4 and IPv6 are both accepted (for example 203.0.113.10,2001:db8:1::7,2001:db8:abcd::/48).
# ALLOW_PRIVATE_ADMIN_IPS: also allow loopback/RFC1918 clients (SSH tunnel or LAN access) so an
# operator can still reach the admin API when their public IP changes.
ADMIN_IP_WHITELIST=""
ALLOW_PRIVATE_ADMIN_IPS="false"

# Enable only when the application is reachable exclusively through a trusted
# reverse proxy that overwrites client forwarding headers.
TRUST_PROXY_HEADERS="false"
# Number of reverse-proxy hops trusted when resolving the client IP (1-5).
# Keep 1 for Nginx → Node on the same host. Set 2 only when a CDN/proxy layer
# (e.g. Cloudflare) sits in front of Nginx, otherwise the admin IP allowlist sees
# the CDN edge address instead of the operator address.
TRUST_PROXY_HOPS="1"

# Google Identity Services. Use the same Web OAuth client ID in both values.
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
# Optional future social integrations; keep secrets server-side only.
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="set-only-in-your-secret-manager"
# TikTok link imports require `python3 -m pip install --user --break-system-packages yt-dlp`
# on Debian's externally-managed Python, or an equivalent isolated yt-dlp install.
# Optionally set an absolute path to a yt-dlp executable; otherwise Python's yt_dlp module is used.
# YT_DLP_PATH="/usr/local/bin/yt-dlp"
# Use dedicated WeChat Mini Program credentials; AppID must match project.config.json.
WECHAT_MINIPROGRAM_APP_ID="your-wechat-mini-program-app-id"
WECHAT_MINIPROGRAM_APP_SECRET="set-only-in-your-secret-manager"
# Optional server-side message push endpoint settings. Keep the token and AES key private.
WECHAT_MINIPROGRAM_MESSAGE_TOKEN=""
WECHAT_MINIPROGRAM_MESSAGE_ENCRYPTION_MODE="secure"
WECHAT_MINIPROGRAM_MESSAGE_AES_KEY=""
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="set-only-in-your-secret-manager"
# Privy App ID is public and may be exposed to the browser. Never put a Privy App Secret here.
VITE_PRIVY_APP_ID="cmuka952h01hm0dl6ndm4m8x7"
# Use at least 32 random characters; required for signed order and item checkout links.
SHARE_LINK_SECRET="set-a-long-random-secret"
ADMIN_TOTP_ENCRYPTION_KEY="set-a-separate-long-random-secret"

# Optional seed-only demo passwords; do not enable demo login in production.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-seeding"
DEMO_BUYER_PASSWORD="change-me-before-seeding"
DEMO_MERCHANT_PASSWORD="change-me-before-seeding"

# Keep online payment providers disabled until their credentials and required
# secrets are configured server-side. Solana Pay also needs the RPC and wallet
# settings below.
PAYMENT_PROVIDER="manual"
PAYMENT_ENABLED="false"
# PAYMENT_PROVIDER_SECRET="set-only-in-your-secret-manager"
# ModaGPT billing mode is test by default; live mode requires sk_live_,
# a separate webhook secret, and the explicit Live Mode purchase opt-in.
MODAGPT_BILLING_MODE="test"
MODAGPT_BILLING_TEST_PURCHASES_ENABLED="false"
# MODAGPT_BILLING_LIVE_PURCHASES_ENABLED="false"
# BILLING_STRIPE_AUTOMATIC_TAX="false"
# PAYMENT_WEBHOOK_SECRET="whsec_... (Stripe Test Mode endpoint secret)"
# MODAGPT_BILLING_STRIPE_WEBHOOK_SECRET="whsec_... (Stripe Live Mode endpoint secret)"

# Use a Solana mainnet RPC provider with adequate rate limits for payment confirmation.
# Keep provider credentials in the deployment secret manager if the URL contains a token.
# SOLANA_RPC_URL="https://your-mainnet-rpc-provider.example"
# Public address of RUDA's non-custodial treasury wallet; no private key belongs in RUDA.
# SOLANA_PLATFORM_WALLET_ADDRESS="your-platform-public-wallet-address"

# Optional S3-compatible object storage for storefront/product media.
# Supports AWS S3, Cloudflare R2, MinIO, and compatible OSS gateways.
OBJECT_STORAGE_ENDPOINT="https://<account-or-region-endpoint>"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET="ruda-media"
OBJECT_STORAGE_ACCESS_KEY_ID="set-only-in-your-secret-manager"
OBJECT_STORAGE_SECRET_ACCESS_KEY="set-only-in-your-secret-manager"
OBJECT_STORAGE_PUBLIC_BASE_URL="https://cdn.example.com"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"

# Cloudflare R2 media storage. When any R2_* value is set, the media service
# uses this configuration as a whole (it never mixes R2 and admin S3 credentials).
# R2_ENDPOINT is the account endpoint only; bucket name is configured separately.
# Keep Access Key ID and Secret Access Key in the deployment secret manager.
# Do not use an r2.dev URL for production delivery; use the configured custom domain.
R2_ACCOUNT_ID="5c30b9d637c252b8faf821fddfa4be04"
R2_ENDPOINT="https://5c30b9d637c252b8faf821fddfa4be04.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="set-only-in-your-secret-manager"
R2_SECRET_ACCESS_KEY="set-only-in-your-secret-manager"
R2_BUCKET_NAME="ruda888"
# Create this separate bucket first and keep it unbound to any public domain.
R2_PRIVATE_BUCKET_NAME="ruda-media-private"
R2_PUBLIC_URL="https://images.ruda.fashion"
