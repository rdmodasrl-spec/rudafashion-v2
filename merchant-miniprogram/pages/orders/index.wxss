.order-list-screen {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 头部与操作 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.title-group {
  display: flex;
  flex-direction: column;
}

.add-btn {
  height: 72rpx !important;
  min-height: 72rpx !important;
  padding: 0 var(--space-md) !important;
  font-size: 24rpx !important;
}

/* 快速通道 */
.quick-access {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.access-item {
  height: 120rpx;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  padding: 0 var(--space-lg);
  gap: var(--space-md);
  transition: all 0.2s ease;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, .04), inset 0 1rpx 0 #fff, inset 0 0 0 1rpx #e8e8e8;
}

.access-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.access-item text {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--ink-primary);
}

/* 搜索与筛选 */
.search-container {
  margin-bottom: var(--space-md);
}

.modern-search {
  height: 88rpx;
  background: linear-gradient(180deg, #fff 0%, #fafafa 100%);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  padding: 0 var(--space-md);
  border: 1rpx solid #e7e7e7;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, .035), inset 0 1rpx 0 #fff;
}

.search-icon-inner {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--space-sm);
  flex: 0 0 32rpx;
}

.search-input-field {
  flex: 1;
  font-size: var(--font-size-sm);
}

.filter-scroll-view {
  margin-bottom: var(--space-lg);
  white-space: nowrap;
}

.filter-chips {
  display: flex;
  gap: var(--space-sm);
}

.filter-chip {
  padding: 12rpx 32rpx;
  background: var(--paper-tertiary);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-tertiary);
}

.filter-chip.active {
  background: var(--ink-primary);
  color: var(--paper-primary);
}

/* 订单卡片 */
.order-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.order-card {
  padding: var(--space-md) !important;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-md);
}

.order-meta {
  display: flex;
  flex-direction: column;
}

.order-no {
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--ink-primary);
  letter-spacing: -0.5rpx;
}

.order-time {
  font-size: 18rpx;
  color: var(--ink-quaternary);
  margin-top: 4rpx;
}

.order-body {
  margin-bottom: var(--space-md);
}

.order-customer {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--ink-secondary);
  margin-bottom: var(--space-sm);
}

.order-financials {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  background: var(--paper-secondary);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
}

.order-qty {
  font-size: 22rpx;
  color: var(--ink-tertiary);
  font-weight: 600;
}

.order-total {
  display: flex;
  align-items: baseline;
}

.order-total .currency {
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 4rpx;
}

.order-total .amount {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

/* 履约区 */
.fulfillment-area {
  margin-top: var(--space-md);
}

.shipping-inputs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.ruda-input.sm {
  height: 72rpx;
  font-size: 20rpx;
}

.action-btns {
  display: flex;
  gap: var(--space-sm);
}

.flex-1 { flex: 1; }

/* 模态框 */
.full-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--paper-primary);
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.modal-header {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--space-lg);
  border-bottom: var(--border-fine);
}

.modal-close { display: flex; align-items: center; width: 64rpx; }
.modal-close-icon { display: block; width: 32rpx; height: 32rpx; }
.modal-close:active { opacity: .6; transform: scale(.94); }
.button-icon-plus { display: block; width: 28rpx; height: 28rpx; margin-right: 6rpx; }
.modal-title { flex: 1; text-align: center; font-weight: 700; font-size: 32rpx; }
.modal-spacer { width: 64rpx; }

.modal-content { flex: 1; padding: var(--space-lg); }

.modal-footer {
  padding: var(--space-lg);
  border-top: var(--border-fine);
}

.shipment-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) !important;
}

.shipment-item-row .item-name {
  color: #292825;
  font-weight: 600;
  letter-spacing: .1rpx;
}

.shipment-item-row .item-sku {
  color: #898680;
}

.qty-input {
  width: 120rpx !important;
  text-align: center;
  border-color: #e4e1dc;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #fff 0%, #f8f7f5 100%);
  box-shadow: inset 0 1rpx 2rpx rgba(29, 27, 25, .035), 0 1rpx 0 #fff;
}

.qty-input:focus {
  border-color: #aaa69e;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(29, 27, 25, .045);
}

.shipment-shipping-info {
  margin-top: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.shipment-shipping-info .caption,
.shipment-history > .caption {
  color: #56534e;
  font-weight: 600;
}

.shipment-shipping-info .ruda-input {
  border-color: #e7e5e1;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fff 0%, #faf9f7 100%);
  box-shadow: inset 0 1rpx 2rpx rgba(29, 27, 25, .025), 0 1rpx 0 #fff;
  transition: border-color var(--motion-fast), box-shadow var(--motion-fast), background-color var(--motion-fast);
}

.shipment-shipping-info .ruda-input:focus {
  border-color: #aaa69e;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(29, 27, 25, .045);
}

.history-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eeece8;
}

.history-row:last-child { border-bottom: none; }

.history-no { color: #34322f; font-size: 22rpx; font-weight: 700; letter-spacing: .1rpx; }
.history-meta { color: #85827d; font-size: 20rpx; }

/* 加载动画 */
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--paper-tertiary);
  border-top-color: var(--ink-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: var(--space-sm);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md);
  font-size: 22rpx;
  color: var(--ink-quaternary);
}

.status-notice.error { color: var(--accent-error); }

