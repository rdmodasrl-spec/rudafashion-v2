<view class="counterparty-page">
  <view class="page-header">
    <text class="page-title">往来单位</text>
  </view>

  <view class="tab-switch">
    <view class="tab-item {{activeTab === 'customers' ? 'tab-active' : ''}}" data-tab="customers" bindtap="selectTab">客户</view>
    <view class="tab-item {{activeTab === 'suppliers' ? 'tab-active' : ''}}" data-tab="suppliers" bindtap="selectTab">供应商</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在加载往来单位…</view>
  <view wx:elif="{{error}}" class="error-card">
    <text>{{error}}</text>
    <button class="small-button" bindtap="retry">重试</button>
  </view>
  <block wx:else>
    <view wx:if="{{activeTab === 'customers'}}" class="tab-panel">
      <view class="panel-heading">
      <button wx:if="{{canManageCustomer}}" class="add-button" bindtap="openCreateCustomer">＋ 新增</button>
      </view>
      <view wx:if="{{canManageCustomer}}" class="search-box">
        <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
        <input value="{{customerQuery}}" data-role="customers" bindinput="onSearch" placeholder="搜索客户名称、联系人或电话" confirm-type="search" />
        <text wx:if="{{customerQuery}}" class="clear-search" data-role="customers" bindtap="clearSearch">清除</text>
      </view>
      <view wx:if="{{canManageCustomer && !customerError}}" class="summary-grid">
        <view class="summary-card summary-card--primary">
          <text class="summary-label">客户档案</text>
          <text class="summary-value">{{customerStats.total}}</text>
        </view>
        <view class="summary-card">
          <text class="summary-label">关联单位</text>
          <text class="summary-value">{{customerStats.linked}}</text>
        </view>
      </view>
      <view wx:if="{{customerError}}" class="inline-error">
        <text>{{customerError}}</text>
        <button class="text-button" bindtap="retry">重试</button>
      </view>
      <view wx:elif="{{!canManageCustomer}}" class="state-card compact-state">当前账号没有客户管理权限。</view>
      <view wx:elif="{{visibleCustomers.length}}" class="record-list">
        <view wx:for="{{visibleCustomers}}" wx:key="id" class="record-card" data-role="customers" data-id="{{item.id}}" bindtap="openDetail">
          <view class="record-main">
            <view class="record-avatar">{{item.companyName ? item.companyName[0] : (item.name ? item.name[0] : '客')}}</view>
            <view class="record-copy">
              <text class="record-name">{{item.companyName || item.name || '未命名客户'}}</text>
              <text class="record-meta">{{item.contactPerson || '未填写联系人'}}<text wx:if="{{item.phone}}"> · {{item.phone}}</text></text>
              <text wx:if="{{item.city || item.country}}" class="record-meta">{{item.city}}{{item.city && item.country ? '，' : ''}}{{item.country}}</text>
            </view>
            <text class="record-arrow">›</text>
          </view>
          <view class="record-actions">
            <text class="identity-tag">客户</text>
            <text wx:if="{{item.counterpartyId}}" class="shared-tag">已关联单位档案</text>
            <button class="edit-button" data-role="customers" data-id="{{item.id}}" catchtap="editItem">编辑</button>
          </view>
        </view>
      </view>
      <view wx:elif="{{customerQuery}}" class="state-card">没有找到相关客户。<text class="state-action" data-role="customers" bindtap="clearSearch">清除搜索</text></view>
      <view wx:elif="{{!customerError}}" class="state-card empty-state">
        <text class="empty-title">暂无客户</text>
        <text class="empty-caption">添加后可用于开单</text>
        <button class="add-button empty-add" bindtap="openCreateCustomer">＋ 添加客户</button>
      </view>
    </view>

    <view wx:if="{{activeTab === 'suppliers'}}" class="tab-panel">
      <view class="panel-heading">
      <button wx:if="{{canManageSupplier}}" class="add-button" bindtap="openCreateSupplier">＋ 新增</button>
      </view>
      <view wx:if="{{canManageSupplier}}" class="search-box">
        <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
        <input value="{{supplierQuery}}" data-role="suppliers" bindinput="onSearch" placeholder="搜索供应商名称、联系人或电话" confirm-type="search" />
        <text wx:if="{{supplierQuery}}" class="clear-search" data-role="suppliers" bindtap="clearSearch">清除</text>
      </view>
      <view wx:if="{{canManageSupplier && !supplierError}}" class="summary-grid">
        <view class="summary-card summary-card--primary">
          <text class="summary-label">供应商档案</text>
          <text class="summary-value">{{supplierStats.total}}</text>
        </view>
        <view class="summary-card">
          <text class="summary-label">关联单位</text>
          <text class="summary-value">{{supplierStats.linked}}</text>
        </view>
      </view>
      <view wx:if="{{supplierError}}" class="inline-error">
        <text>{{supplierError}}</text>
        <button class="text-button" bindtap="retry">重试</button>
      </view>
      <view wx:elif="{{!canManageSupplier}}" class="state-card compact-state">当前账号没有供应商管理权限。</view>
      <view wx:elif="{{visibleSuppliers.length}}" class="record-list">
        <view wx:for="{{visibleSuppliers}}" wx:key="id" class="record-card" data-role="suppliers" data-id="{{item.id}}" bindtap="openDetail">
          <view class="record-main">
            <view class="record-avatar record-avatar--supplier">{{item.name ? item.name[0] : (item.counterparty.companyName ? item.counterparty.companyName[0] : '供')}}</view>
            <view class="record-copy">
              <text class="record-name">{{item.name || item.counterparty.companyName || '未命名供应商'}}</text>
              <text class="record-meta">{{item.contactName || '未填写联系人'}}<text wx:if="{{item.phone}}"> · {{item.phone}}</text></text>
              <text wx:if="{{item.counterparty.city || item.country}}" class="record-meta">{{item.counterparty.city}}{{item.counterparty.city && item.country ? '，' : ''}}{{item.country}}</text>
            </view>
            <text class="record-arrow">›</text>
          </view>
          <view class="record-actions">
            <text class="identity-tag supplier-tag">供应商</text>
            <text wx:if="{{item.counterpartyId}}" class="shared-tag">已关联单位档案</text>
            <button class="edit-button" data-role="suppliers" data-id="{{item.id}}" catchtap="editItem">编辑</button>
          </view>
        </view>
      </view>
      <view wx:elif="{{supplierQuery}}" class="state-card">没有找到相关供应商。<text class="state-action" data-role="suppliers" bindtap="clearSearch">清除搜索</text></view>
      <view wx:elif="{{!supplierError}}" class="state-card empty-state">
        <text class="empty-title">暂无供应商</text>
        <text class="empty-caption">添加后可用于采购</text>
        <button class="add-button empty-add" bindtap="openCreateSupplier">＋ 添加供应商</button>
      </view>
    </view>
  </block>

  <view wx:if="{{editorOpen}}" class="overlay" catchtap="cancelEditor">
    <view class="editor-sheet" catchtap="noop">
      <view class="sheet-heading">
        <text class="sheet-title">{{editorMode === 'edit' ? '编辑' : '新增'}}{{formRole === 'customer' ? '客户' : '供应商'}}</text>
        <text class="sheet-close" bindtap="cancelEditor">×</text>
      </view>
      <scroll-view class="sheet-content" scroll-y>
        <picker wx:if="{{editorMode === 'create' && linkCandidates.length}}" range="{{linkCandidates}}" range-key="companyName" value="{{linkCandidateIndex}}" bindchange="onLinkCandidateChange">
          <view class="link-picker">
            <text class="field-label">关联已有单位（可选）</text>
            <text class="picker-value">{{form.counterpartyId ? form.name : '不关联，创建新档案'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <text wx:if="{{editorMode === 'create' && linkCandidates.length}}" class="form-hint">关联已有公司以新增业务身份，不重复建档。</text>
        <view class="form-field">
          <text class="field-label">公司名称 <text class="required">*</text></text>
          <input class="form-input" data-field="name" value="{{form.name}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="请输入公司名称" />
        </view>
        <view class="form-field">
          <text class="field-label">联系人</text>
          <input class="form-input" data-field="contactName" value="{{form.contactName}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="联系人姓名" />
        </view>
        <view class="form-field">
          <text class="field-label">联系电话{{formRole === 'customer' ? ' *' : ''}}</text>
          <input class="form-input" type="text" data-field="phone" value="{{form.phone}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="联系电话" />
        </view>
        <view class="form-field">
          <text class="field-label">邮箱</text>
          <input class="form-input" data-field="email" value="{{form.email}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="联系邮箱" />
        </view>
        <view class="form-row">
          <view class="form-field half-field">
            <text class="field-label">国家/地区</text>
            <input class="form-input" data-field="country" value="{{form.country}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" />
          </view>
          <view class="form-field half-field">
            <text class="field-label">城市</text>
            <input class="form-input" data-field="city" value="{{form.city}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="城市" />
          </view>
        </view>
        <view class="form-field">
          <text class="field-label">地址</text>
          <input class="form-input" data-field="address" value="{{form.address}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="公司地址" />
        </view>
        <view class="form-field">
          <text class="field-label">VAT 税号</text>
          <input class="form-input" data-field="vatNumber" value="{{form.vatNumber}}" bindinput="onFormInput" disabled="{{editorMode === 'create' && form.counterpartyId}}" placeholder="选填" />
        </view>
        <view wx:if="{{formRole === 'supplier'}}" class="form-field">
          <text class="field-label">预计交期（天）</text>
          <input class="form-input" type="number" data-field="leadTimeDays" value="{{form.leadTimeDays}}" bindinput="onFormInput" />
        </view>
        <view class="form-field">
          <text class="field-label">备注</text>
          <textarea class="form-textarea" data-field="notes" value="{{form.notes}}" bindinput="onFormInput" placeholder="记录业务备注（选填）" maxlength="2000" />
        </view>
        <view wx:if="{{error}}" class="form-error">{{error}}</view>
      </scroll-view>
      <view class="sheet-actions">
        <button class="cancel-button" bindtap="cancelEditor">取消</button>
        <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveCounterparty">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{selectedDetail}}" class="overlay" catchtap="closeDetail">
    <view class="detail-sheet" catchtap="noop">
      <view class="sheet-heading">
        <text class="sheet-title">{{selectedDetail.role === 'customers' ? '客户详情' : '供应商详情'}}</text>
        <text class="sheet-close" bindtap="closeDetail">×</text>
      </view>
      <scroll-view class="sheet-content" scroll-y>
        <view class="detail-card">
          <view class="detail-profile">
            <view class="detail-avatar">{{selectedDetail.item.companyName ? selectedDetail.item.companyName[0] : (selectedDetail.item.name ? selectedDetail.item.name[0] : 'RU')}}</view>
            <view class="detail-profile-copy">
              <text class="detail-name">{{selectedDetail.item.companyName || selectedDetail.item.name || selectedDetail.item.counterparty.companyName}}</text>
              <text class="detail-role">{{selectedDetail.role === 'customers' ? '客户档案' : '供应商档案'}}</text>
            </view>
          </view>
          <view class="detail-info-list">
            <view class="detail-info-row">
              <text class="detail-info-label">联系人</text>
              <text class="detail-info-value">{{selectedDetail.item.contactPerson || selectedDetail.item.contactName || '未填写'}}</text>
            </view>
            <view wx:if="{{selectedDetail.item.phone}}" class="detail-info-row">
              <text class="detail-info-label">联系电话</text>
              <text class="detail-info-value">{{selectedDetail.item.phone}}</text>
            </view>
            <view wx:if="{{selectedDetail.item.email}}" class="detail-info-row">
              <text class="detail-info-label">邮箱</text>
              <text class="detail-info-value">{{selectedDetail.item.email}}</text>
            </view>
            <view wx:if="{{selectedDetail.item.address || selectedDetail.item.counterparty.address}}" class="detail-info-row">
              <text class="detail-info-label">地址</text>
              <text class="detail-info-value">{{selectedDetail.item.address || selectedDetail.item.counterparty.address}}</text>
            </view>
            <view wx:if="{{selectedDetail.item.vatNumber || selectedDetail.item.counterparty.vatNumber}}" class="detail-info-row">
              <text class="detail-info-label">VAT 税号</text>
              <text class="detail-info-value">{{selectedDetail.item.vatNumber || selectedDetail.item.counterparty.vatNumber}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{!detailLoading && !detailError}}" class="detail-stats">
          <view wx:for="{{detailStats}}" wx:key="label" class="detail-stat">
            <text class="detail-stat-label">{{item.label}}</text>
            <text class="detail-stat-value">{{item.value}}</text>
          </view>
        </view>
        <view class="history-heading">
          <text class="section-title">{{selectedDetail.role === 'customers' ? '销售订单' : '采购记录'}}</text>
          <text class="section-caption">{{selectedDetail.role === 'customers' ? detailOrders.length : detailPurchaseOrders.length}} 条记录</text>
        </view>
        <view wx:if="{{detailLoading}}" class="state-card compact-state">正在加载业务记录…</view>
        <view wx:elif="{{detailError}}" class="inline-error">{{detailError}}</view>
        <block wx:elif="{{selectedDetail.role === 'customers'}}">
          <view wx:for="{{detailOrders}}" wx:key="id" class="history-row">
            <view>
              <text class="history-id">{{item.orderNumber || item.id}}</text>
              <text class="history-date">{{item.createdAt}}</text>
            </view>
            <view class="history-right">
              <text class="history-status">{{item.status || '—'}}</text>
              <text class="history-amount">{{item.totalAmount}}</text>
            </view>
          </view>
          <view wx:if="{{!detailOrders.length && !detailLoading}}" class="state-card compact-state">暂无销售订单记录</view>
        </block>
        <block wx:else>
          <view wx:for="{{detailPurchaseOrders}}" wx:key="id" class="history-row">
            <view>
              <text class="history-id">{{item.orderNumber || item.id}}</text>
              <text class="history-date">{{item.createdAt}}</text>
            </view>
            <view class="history-right">
              <text class="history-status">{{item.status || '—'}}</text>
              <text class="history-amount">{{item.displayAmount}}</text>
            </view>
          </view>
          <view wx:if="{{!detailPurchaseOrders.length && !detailLoading}}" class="state-card compact-state">暂无采购记录</view>
        </block>
      </scroll-view>
      <view class="sheet-actions">
        <button class="save-button detail-done" bindtap="closeDetail">完成</button>
      </view>
    </view>
  </view>
</view>
