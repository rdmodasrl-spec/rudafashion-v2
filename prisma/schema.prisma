  merchantAiEmployeeInstallation MerchantAiEmployeeInstallation[]
  merchantAiEmployeeMemory       MerchantAiEmployeeMemory[]
  merchantAiOrderDraft           MerchantAiOrderDraft[]
  merchantAiTeamAssignment       MerchantAiTeamAssignment[]
  merchantAiTeamProvisionRun     MerchantAiTeamProvisionRun[]
  merchantAssistantConversation  MerchantAssistantConversation[]
  merchantAssistantMemory        MerchantAssistantMemory[]
  merchantBankAccount            MerchantBankAccount[]
  merchantCustomerLink           MerchantCustomerLink[]
  merchantCounterparty           MerchantCounterparty[]
  merchantGrowthReferral         MerchantGrowthReferral[]         @relation("GrowthReferralReferrer")
  merchantGrowthReferralReferred MerchantGrowthReferral[]         @relation("GrowthReferralReferred")
  merchantPromotionBenefit       MerchantPromotionBenefit[]       @relation("PromotionBenefitMerchant")
  merchantPromotionBenefitSource MerchantPromotionBenefit[]       @relation("PromotionBenefitSourceMerchant")
  merchantEmployee               MerchantEmployee[]
  merchantEmailDomain            MerchantEmailDomain[]
  merchantModaGptDesign          MerchantModaGptDesign[]
  merchantPayPalConfig           MerchantPayPalConfig?
  merchantPayout                 MerchantPayout[]
  merchantPosShift               MerchantPosShift[]
  merchantPosSale                MerchantPosSale[]
  merchantStore                  MerchantStore[]
  merchantStoreStock             MerchantStoreStock[]
  merchantStoreTransfer          MerchantStoreTransfer[]
  merchantPurchaseOrder          MerchantPurchaseOrder[]
  merchantSolanaConfig           MerchantSolanaConfig?
  storeCategories                MerchantStoreCategory[]
  merchantStripeConfig           MerchantStripeConfig?
  merchantSupportConversation    MerchantSupportConversation[]
  merchantSupportMemory          MerchantSupportMemory[]
  merchantWorkspaceDraft         MerchantWorkspaceDraft[]
  appInstallation                AppInstallation[]
  modaGptAiUsageRecord           ModaGptAiUsageRecord[]
