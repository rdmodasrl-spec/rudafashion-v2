.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #737373;
}

.state-error {
  color: #b91c1c;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e5e5e5;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0a0a0a;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e5e5e5;
  background: #fafafa;
  font-size: 20rpx;
  color: #525252;
}

.badge-on {
  border-color: #a7f3d0;
  background: #ecfdf5;
  color: #047857;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #0a0a0a;
}

.hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #737373;
}

.quota {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f0f0f0;
}

.quota-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.quota-label {
  font-size: 22rpx;
  color: #737373;
}

.quota-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #0a0a0a;
}

.centers {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.center {
  flex: 1 1 46%;
  padding: 18rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #e5e5e5;
  background: #fafafa;
}

.center-ready {
  border-style: solid;
  background: #ffffff;
}

.center-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.center-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #171717;
}

.center-status {
  font-size: 18rpx;
  font-weight: 700;
  color: #737373;
}

.center-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8a8a8a;
}

.tool {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f0f0;
}

.tool:first-of-type {
  border-top: none;
}

.tool-main {
  flex: 1;
  min-width: 0;
}

.tool-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0a0a0a;
}

.tool-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #737373;
}

.tool-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a3a3a3;
}

.tool-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.btn {
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.btn-primary {
  background: #0a0a0a;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #404040;
  border: 2rpx solid #d4d4d4;
}

.btn-block {
  margin-top: 24rpx;
  width: 100%;
}

.blocked {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f0f0f0;
}

.blocked-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #a3a3a3;
}

.blocked-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 6rpx 0;
}

.blocked-name {
  font-size: 22rpx;
  color: #737373;
}

.blocked-reason {
  font-size: 20rpx;
  color: #8a8a8a;
}

.label {
  display: block;
  margin: 20rpx 0 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #404040;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 2rpx solid #d4d4d4;
  font-size: 24rpx;
  color: #171717;
  background: #ffffff;
}

.picker {
  padding: 18rpx;
  border-radius: 16rpx;
  border: 2rpx solid #d4d4d4;
  font-size: 24rpx;
  color: #171717;
  background: #ffffff;
}

.result {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fafafa;
  border: 2rpx solid #e5e5e5;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.result-title {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #737373;
}

.result-body {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #171717;
  white-space: pre-wrap;
  word-break: break-word;
}
