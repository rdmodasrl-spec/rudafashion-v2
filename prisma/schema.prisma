  industryTemplateInitializedAt  DateTime?
  registrationProfile            Json?
  storefrontEnabled              Boolean?
  aiEmployeeCreativeDraft        AiEmployeeCreativeDraft[]
  aiEmployeeProductContentDraft  AiEmployeeProductContentDraft[]
  aiEmployeeProductImportDraft   AiEmployeeProductImportDraft[]
  employeeAuditLog               EmployeeAuditLog[]
  inventoryBalance               InventoryBalance[]
  inventoryMovement              InventoryMovement[]
  material                       Material[]
